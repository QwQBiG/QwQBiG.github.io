---
import { readingListPrefetch } from '../utils/content-navigation';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import ContentIcon from '../components/ui/ContentIcon.astro';
import { loadContent } from '../utils/load-content';
import { groupByYear } from '../utils/date';

const { csPosts: sortedPosts } = await loadContent();

// Group by year
const postsByYear = groupByYear(sortedPosts);
const monthDay = new Intl.DateTimeFormat('en-US', {
  timeZone: 'Asia/Shanghai', month: 'short', day: 'numeric',
});

const pageTitle = "Archives - QwQBiG's World";
const pageDescription = "Browse posts by year.";
---

<Layout title={pageTitle} description={pageDescription}>
  <FloatingNavCard />
  
  <main class="flex-1 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="text-center mb-12">
        <h1 class="font-sans font-bold text-3xl md:text-4xl text-text-primary mb-4 inline-flex items-center gap-3">
          <ContentIcon name="archive" />Archives
        </h1>
        <p class="font-sans text-lg text-text-secondary">
          {sortedPosts.length} {sortedPosts.length === 1 ? 'post' : 'posts'}
        </p>
      </div>

      <!-- Archives by Year -->
      <div class="space-y-12">
        {Array.from(postsByYear.entries()).map(([year, posts], yearIndex) => (
          <section class="archive-year">
            <h2 class="archive-year-title">
              {year}
              <span class="text-sm font-normal text-text-muted ml-2">({posts.length} {posts.length === 1 ? 'post' : 'posts'})</span>
            </h2>
            
            <div class="archive-list">
              {posts.map((post, index) => {
                const collection = post.collection;
                const url = `/${collection}/${post.slug}/`;
                const series = post.collection === 'cs' ? post.data.series : undefined;
                
                return (
                  <a href={url} data-astro-prefetch={yearIndex === 0 ? readingListPrefetch(index) : undefined} class="archive-item group">
                    <time class="archive-date font-mono min-w-[6ch]" datetime={post.data.date.toISOString()}>
                      {monthDay.format(post.data.date)}
                    </time>
                    <span class="archive-title group-hover:text-primary transition-colors">
                      {post.data.title}
                    </span>
                    {series && series.length > 0 && (
                      <span class="ml-auto text-xs text-primary bg-primary/10 px-2 py-1 rounded-full">
                        {series[0]}
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
