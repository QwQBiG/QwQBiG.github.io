---
import { readingListPrefetch } from '../../utils/content-navigation';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/layout/Footer.astro';
import PostCard from '../../components/content/PostCard.astro';
import FloatingNavCard from '../../components/layout/FloatingNavCard.astro';
import { loadContent } from '../../utils/load-content';
import { getPostTags, getTagKey, type Post } from '../../utils/content';

interface Props {
  tag: string;
  posts: Post[];
}

export async function getStaticPaths() {
  const { posts, tags } = await loadContent();
  return tags.map(([tag]) => ({
    params: { tag: getTagKey(tag) },
    props: { tag, posts: posts.filter(post => getPostTags(post).some(value => getTagKey(value) === getTagKey(tag))) },
  }));
}

const { tag, posts: sortedPosts } = Astro.props;

const pageTitle = `Posts tagged “${tag}” - QwQBiG's World`;
const pageDescription = `Posts tagged “${tag}”.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <FloatingNavCard />
  
  <main class="flex-1 py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-full text-sm font-medium mb-4">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
          Tag
        </div>
        <h1 class="font-sans font-bold text-3xl md:text-4xl text-text-primary mb-4">
          #{tag}
        </h1>
        <p class="font-sans text-lg text-text-secondary">
          {sortedPosts.length} {sortedPosts.length === 1 ? 'post' : 'posts'}
        </p>
      </div>

      <!-- Posts Grid -->
      {sortedPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedPosts.map((post, index) => (
            <PostCard post={post} collection={post.collection} prefetch={readingListPrefetch(index)} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-text-secondary">No posts with this tag yet.</p>
        </div>
      )}
      
      <!-- Back to Tags -->
      <div class="text-center mt-12">
        <a 
          href="/tags/"
          class="inline-flex items-center gap-2 text-primary hover:text-primary-dark font-medium"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          All tags
        </a>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
