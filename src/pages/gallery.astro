---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import PhotoWall from '../components/3d/PhotoWall.tsx';
import type { PhotoItem } from '../types/photo';

const pageTitle = "画廊 - QwQBiG's World";
const pageDescription = "3D 散落照片墙 - 拖拽探索，点击查看大图";

// 自动扫描 public/gallery 目录，直接丢图片进去即可
const galleryDir = path.join(process.cwd(), 'public', 'gallery');
const imageExtensions = ['.png', '.jpg', '.jpeg', '.gif', '.webp'];

const photos: PhotoItem[] = fs.readdirSync(galleryDir)
  .filter(file => imageExtensions.includes(path.extname(file).toLowerCase()))
  .map((file, index) => {
    const halfSizeFiles = ['ZhenXun.jpg', 'AIcard.png'];
    return {
      id: String(index + 1),
      src: `/gallery/${file}`,
      alt: path.basename(file, path.extname(file)),
      scale: halfSizeFiles.includes(file) ? 0.5 : undefined,
    };
  });
---

<Layout title={pageTitle} description={pageDescription}>
  {photos.filter(p => /\.(png|jpe?g)$/i.test(p.src)).map(p => (
    <link rel="preload" href={p.src} as="image" />
  ))}
  <FloatingNavCard />

  <main class="flex-1 h-screen relative overflow-hidden">
    {/* 渐变背景 */}
    <div class="absolute inset-0 gradient-bg -z-10"></div>

    {/* 3D 照片墙组件 - 全屏显示 */}
    <div class="h-full">
      <PhotoWall photos={photos} client:load />
    </div>
  </main>
</Layout>

<style>
  /* 手写体字体 */
  .font-handwriting {
    font-family: 'Caveat', 'Dancing Script', cursive;
  }

  /* 确保照片墙容器正确显示 */
  :global(.photo-wall-container) {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* 响应式调整 */
  @media (max-width: 768px) {
    :global(.photo-card) {
      width: 150px !important;
    }
  }

  @media (max-width: 480px) {
    :global(.photo-card) {
      width: 120px !important;
    }
  }
</style>
