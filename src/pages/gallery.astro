---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/LightLayout.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import PhotoWall from '../components/3d/PhotoWall.tsx';
import type { PhotoItem } from '../types/photo';
import { desktopPhotoWidth, photoAnchorY, photoFrameHeightRatio, photoWallMedia, photoWallSizes, photoWallTiers } from '../utils/photo-wall';

interface GalleryManifestEntry {
  file: string;
  alt: string;
  width: number;
  height: number;
  thumb2x: string;
  srcset: string;
  preview: string;
}

const pageTitle = "画廊 - QwQBiG's World";
const pageDescription = "3D 散落照片墙 - 拖拽探索，点击查看大图";
const manifestPath = path.join(process.cwd(), 'public', 'generated', 'gallery', 'manifest.json');
const entries = JSON.parse(fs.readFileSync(manifestPath, 'utf8')) as GalleryManifestEntry[];
const halfSizeFiles = new Set(['ZhenXun.jpg', 'AIcard.png']);

const photos: PhotoItem[] = entries.map((entry, index) => {
  const scale = halfSizeFiles.has(entry.file) ? 0.5 : 1;
  return {
    id: String(index + 1),
    src: entry.thumb2x,
    preview: entry.preview,
    alt: entry.alt,
    width: entry.width,
    height: entry.height,
    scale,
    srcset: entry.srcset,
    sizes: photoWallSizes(scale),
  };
});

const photoIds = photos.map(photo => photo.id);
const compactScreens = photoWallTiers.map(photoWallMedia).join(', ');
const galleryBreakpoints = [
  `:root { --gallery-card-size: ${desktopPhotoWidth}px; }`,
  ...[...photoWallTiers].reverse().map(tier =>
    `@media ${photoWallMedia(tier)} { :root { --gallery-card-size: ${tier.width}px; } }`),
  `@media ${compactScreens} {
    .gallery-main { height: 100dvh; flex: none; }
    body:has(.gallery-main) { min-height: 100dvh; }
    .static-photo-wall .static-photo-card[data-photo-id] {
      --anchor-y: calc(var(--frame-width) * .6);
      left: clamp(var(--min-left), var(--resolved-left), var(--max-left));
      top: clamp(var(--min-top), var(--resolved-top), var(--max-top));
    }
  }`,
].join('');

const initialPositions = [
  { left: '10%', top: '18%', rotate: '-7deg' },
  { left: '58%', top: '10%', rotate: '6deg' },
  { left: '42%', top: '54%', rotate: '-4deg' },
  { left: '73%', top: '46%', rotate: '5deg' },
  { left: '20%', top: '58%', rotate: '8deg' },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <style is:inline set:html={galleryBreakpoints} />
    {photos.map((photo) => (
      <link rel="preload" as="image" imagesrcset={photo.srcset} imagesizes={photo.sizes} type="image/webp" />
    ))}
    <script is:inline define:vars={{ photoIds }}>
      for (const id of photoIds) {
        try {
          const saved = JSON.parse(localStorage.getItem('photo-wall-' + id) || 'null');
          if (!saved || !Number.isFinite(saved.x) || !Number.isFinite(saved.y)) continue;
          const rotation = Number.isFinite(saved.rotation) ? saved.rotation : 0;
          const angle = rotation * Math.PI / 180;
          const style = document.documentElement.style;
          const prefix = '--photo-' + id + '-';
          style.setProperty(prefix + 'cos', Math.abs(Math.cos(angle)));
          style.setProperty(prefix + 'sin', Math.abs(Math.sin(angle)));
          style.setProperty(prefix + 'rotation', rotation + 'deg');
          style.setProperty(prefix + 'z', Number.isFinite(saved.zIndex) ? saved.zIndex : Number(id));
          // Keep the original center-relative coordinates as the viewport rotates.
          style.setProperty(prefix + 'x', saved.x + 'px');
          style.setProperty(prefix + 'y', saved.y + 'px');
        } catch { /* Other photos still restore if this entry is unreadable. */ }
      }
    </script>
  </Fragment>

  <FloatingNavCard />

  <main class="gallery-main flex-1 h-screen relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg -z-10"></div>

    <!-- React/Framer 加载前显示同样的拍立得墙，图片是清晰缩略图，不使用模糊占位。 -->
    <div class="static-photo-wall" data-static-photo-wall aria-hidden="true">
      {photos.map((photo, index) => {
        const position = initialPositions[index % initialPositions.length];
        const scale = photo.scale ?? 1;
        const angle = parseFloat(position.rotate) * Math.PI / 180;
        const prefix = `--photo-${photo.id}-`;
        return (
          <div
            class="static-photo-card"
            data-photo-id={photo.id}
            style={{
              '--scale': scale,
              '--ratio': photoFrameHeightRatio(photo),
              '--desktop-anchor': `${photoAnchorY(desktopPhotoWidth * scale)}px`,
              '--cos': `var(${prefix}cos, ${Math.abs(Math.cos(angle))})`,
              '--sin': `var(${prefix}sin, ${Math.abs(Math.sin(angle))})`,
              '--saved-x': `var(${prefix}x)`,
              '--saved-y': `var(${prefix}y)`,
              '--default-left': position.left,
              '--default-top': position.top,
              '--rotation': `var(${prefix}rotation, ${position.rotate})`,
              'z-index': `var(${prefix}z, ${index})`,
            }}
          >
            <div class="static-photo-frame">
              <img
                srcset={photo.srcset}
                sizes={photo.sizes}
                src={photo.src}
                alt=""
                width={photo.width}
                height={photo.height}
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        );
      })}
    </div>

    <div class="h-full photo-wall-runtime">
      <PhotoWall photos={photos} client:load />
    </div>
  </main>
</Layout>

<script is:inline>
  window.addEventListener('photo-wall-ready', () => {
    document.documentElement.classList.add('photo-wall-ready');
  }, { once: true });
</script>

<style>
  .font-handwriting {
    font-family: 'Caveat', 'Dancing Script', cursive;
  }

  :global(.photo-wall-container) {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .static-photo-wall {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    opacity: 1;
  }

  :global(html.photo-wall-ready) .static-photo-wall {
    opacity: 0;
    visibility: hidden;
  }

  .photo-wall-runtime {
    position: relative;
    z-index: 2;
    opacity: 0;
  }

  :global(html.photo-wall-ready) .photo-wall-runtime {
    opacity: 1;
  }

  .static-photo-card {
    position: absolute;
    left: var(--resolved-left);
    top: var(--resolved-top);
    --frame-width: calc(var(--gallery-card-size) * var(--scale));
    --frame-height: calc((var(--frame-width) - 8px) * var(--ratio) + 8px);
    --anchor-y: var(--desktop-anchor);
    --restored-left: clamp(var(--min-left), calc(50% + var(--saved-x) - var(--frame-width) / 2), var(--max-left));
    --restored-top: clamp(var(--min-top), calc(50% + var(--saved-y) - var(--anchor-y)), var(--max-top));
    --resolved-left: var(--restored-left, var(--default-left));
    --resolved-top: var(--restored-top, var(--default-top));
    /* Match the rotated rectangle used for dragging, including its white frame. */
    --inset-x: calc(12px + (var(--frame-width) * (var(--cos) - 1) + var(--frame-height) * var(--sin)) / 2);
    --inset-y: calc(12px + (var(--frame-height) * (var(--cos) - 1) + var(--frame-width) * var(--sin)) / 2);
    --min-left: min(var(--inset-x), (100% - var(--frame-width)) / 2);
    --min-top: min(var(--inset-y), (100% - var(--frame-height)) / 2);
    --max-left: calc(100% - var(--frame-width) - var(--inset-x));
    --max-top: calc(100% - var(--frame-height) - var(--inset-y));
    width: var(--frame-width);
    transform: rotate(var(--rotation));
  }

  .static-photo-frame {
    padding: 4px;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, .3), 0 4px 6px -2px rgba(0, 0, 0, .1);
  }

  .static-photo-frame img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

</style>
