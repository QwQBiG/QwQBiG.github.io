---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/LightLayout.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import PhotoWall from '../components/3d/PhotoWall.tsx';
import type { PhotoItem } from '../types/photo';

interface GalleryManifestEntry {
  file: string;
  alt: string;
  width: number;
  height: number;
  thumb2x: string;
  preview: string;
}

const pageTitle = "画廊 - QwQBiG's World";
const pageDescription = "3D 散落照片墙 - 拖拽探索，点击查看大图";
const manifestPath = path.join(process.cwd(), 'public', 'generated', 'gallery', 'manifest.json');
const entries = JSON.parse(fs.readFileSync(manifestPath, 'utf8')) as GalleryManifestEntry[];
const halfSizeFiles = new Set(['ZhenXun.jpg', 'AIcard.png']);

const photos: PhotoItem[] = entries.map((entry, index) => ({
  id: String(index + 1),
  src: entry.thumb2x,
  preview: entry.preview,
  alt: entry.alt,
  width: entry.width,
  height: entry.height,
  scale: halfSizeFiles.has(entry.file) ? 0.5 : undefined,
}));

const photoScales = Object.fromEntries(photos.map((photo) => [photo.id, photo.scale ?? 1]));

const initialPositions = [
  { left: '10%', top: '18%', rotate: '-7deg' },
  { left: '58%', top: '10%', rotate: '6deg' },
  { left: '42%', top: '54%', rotate: '-4deg' },
  { left: '73%', top: '46%', rotate: '5deg' },
  { left: '20%', top: '58%', rotate: '8deg' },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    {photos.map((photo) => (
      <link rel="preload" as="image" href={photo.src} type="image/webp" />
    ))}
    <script is:inline define:vars={{ photoScales }}>
      (() => {
        const root = document.documentElement;
        try {
          const viewportWidth = window.innerWidth;
          const baseWidth = viewportWidth < 480 ? 120 : viewportWidth < 768 ? 150 : 360;
          Object.entries(photoScales).forEach(([id, scaleValue]) => {
            const saved = JSON.parse(localStorage.getItem('photo-wall-' + id) || 'null');
            if (!saved || !Number.isFinite(saved.x) || !Number.isFinite(saved.y)) return;
            const width = baseWidth * (Number(scaleValue) || 1);
            const verticalOffset = width < 250 ? width * 0.6 : 100;
            const rotation = Number.isFinite(saved.rotation) ? saved.rotation : 0;
            const zIndex = Number.isFinite(saved.zIndex) ? saved.zIndex : Number(id);
            root.style.setProperty('--photo-' + id + '-left', '50%');
            root.style.setProperty('--photo-' + id + '-top', '50%');
            root.style.setProperty(
              '--photo-' + id + '-transform',
              'translate3d(' + (saved.x - width / 2) + 'px,' + (saved.y - verticalOffset) + 'px,0) rotate(' + rotation + 'deg)',
            );
            root.style.setProperty('--photo-' + id + '-z', String(zIndex));
          });
        } catch {}
        root.classList.add('photo-wall-state-ready');
      })();
    </script>
  </Fragment>

  <FloatingNavCard />

  <main class="flex-1 h-screen relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg -z-10"></div>

    <!-- React/Framer 加载前显示同样的拍立得墙，图片是清晰缩略图，不使用模糊占位。 -->
    <div class="static-photo-wall" data-static-photo-wall aria-hidden="true">
      {photos.map((photo, index) => {
        const position = initialPositions[index % initialPositions.length];
        const scale = photo.scale ?? 1;
        return (
          <div
            class="static-photo-card"
            data-photo-id={photo.id}
            style={`--left:${position.left};--top:${position.top};--rotate:${position.rotate};--desktop-width:${360 * scale}px;--tablet-width:${150 * scale}px;--phone-width:${120 * scale}px;--resolved-left:var(--photo-${photo.id}-left,var(--left));--resolved-top:var(--photo-${photo.id}-top,var(--top));--resolved-transform:var(--photo-${photo.id}-transform,rotate(var(--rotate)));--resolved-z:var(--photo-${photo.id}-z,${index})`}
          >
            <div class="static-photo-frame">
              <img
                src={photo.src}
                alt=""
                width={photo.width}
                height={photo.height}
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        );
      })}
    </div>

    <div class="h-full photo-wall-runtime">
      <PhotoWall photos={photos} client:load />
    </div>
  </main>
</Layout>

<script is:inline>
  window.addEventListener('photo-wall-ready', () => {
    document.documentElement.classList.add('photo-wall-ready');
  }, { once: true });
</script>

<style>
  .font-handwriting {
    font-family: 'Caveat', 'Dancing Script', cursive;
  }

  :global(.photo-wall-container) {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .static-photo-wall {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    opacity: 1;
  }

  :global(html.photo-wall-ready) .static-photo-wall {
    opacity: 0;
    visibility: hidden;
  }

  .photo-wall-runtime {
    position: relative;
    z-index: 2;
    opacity: 0;
  }

  :global(html.photo-wall-ready) .photo-wall-runtime {
    opacity: 1;
  }

  .static-photo-card {
    position: absolute;
    left: var(--resolved-left);
    top: var(--resolved-top);
    width: var(--desktop-width);
    transform: var(--resolved-transform);
    z-index: var(--resolved-z);
  }

  .static-photo-frame {
    padding: 4px;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, .3), 0 4px 6px -2px rgba(0, 0, 0, .1);
  }

  .static-photo-frame img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .static-photo-card { width: var(--tablet-width); }
  }

  @media (max-width: 480px) {
    .static-photo-card { width: var(--phone-width); }
  }
</style>
