---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/LightLayout.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import PhotoWall from '../components/3d/PhotoWall.tsx';
import type { PhotoItem } from '../types/photo';

interface GalleryManifestEntry {
  file: string;
  alt: string;
  width: number;
  height: number;
  thumb2x: string;
  preview: string;
}

const pageTitle = "画廊 - QwQBiG's World";
const pageDescription = "3D 散落照片墙 - 拖拽探索，点击查看大图";
const manifestPath = path.join(process.cwd(), 'public', 'generated', 'gallery', 'manifest.json');
const entries = JSON.parse(fs.readFileSync(manifestPath, 'utf8')) as GalleryManifestEntry[];
const halfSizeFiles = new Set(['ZhenXun.jpg', 'AIcard.png']);

const photos: PhotoItem[] = entries.map((entry, index) => ({
  id: String(index + 1),
  src: entry.thumb2x,
  preview: entry.preview,
  alt: entry.alt,
  width: entry.width,
  height: entry.height,
  scale: halfSizeFiles.has(entry.file) ? 0.5 : undefined,
}));

// 首屏直接内嵌清晰的 720px WebP，避免 HTML 到达后还要等待五个图片请求。
const staticPhotos = entries.map((entry, index) => {
  const thumbPath = path.join(process.cwd(), 'public', ...entry.thumb2x.split('/').filter(Boolean));
  return {
    ...photos[index],
    dataUri: `data:image/webp;base64,${fs.readFileSync(thumbPath).toString('base64')}`,
  };
});

const initialPositions = [
  { left: '10%', top: '18%', rotate: '-7deg' },
  { left: '58%', top: '10%', rotate: '6deg' },
  { left: '42%', top: '54%', rotate: '-4deg' },
  { left: '73%', top: '46%', rotate: '5deg' },
  { left: '20%', top: '58%', rotate: '8deg' },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <FloatingNavCard />

  <main class="flex-1 h-screen relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg -z-10"></div>

    <!-- React/Framer 加载前显示同样的拍立得墙，图片是清晰缩略图，不使用模糊占位。 -->
    <div class="static-photo-wall" data-static-photo-wall aria-hidden="true">
      {staticPhotos.map((photo, index) => {
        const position = initialPositions[index % initialPositions.length];
        return (
          <div
            class="static-photo-card"
            data-photo-id={photo.id}
            style={`--left:${position.left};--top:${position.top};--rotate:${position.rotate};--card-scale:${photo.scale ?? 1}`}
          >
            <div class="static-photo-frame">
              <img
                src={photo.dataUri}
                alt=""
                width={photo.width}
                height={photo.height}
                decoding="sync"
              />
            </div>
          </div>
        );
      })}
    </div>

    <div class="h-full photo-wall-runtime">
      <PhotoWall photos={photos} client:load />
    </div>
  </main>
</Layout>

<script is:inline>
  // 在 React 接管前复用上次位置，避免首屏先闪到默认坐标。
  (() => {
    try {
      const cards = document.querySelectorAll('[data-static-photo-wall] [data-photo-id]');
      const mobile = window.innerWidth < 768;
      const cardWidth = mobile ? (window.innerWidth < 480 ? 120 : 150) : 360;
      cards.forEach((card) => {
        const id = card.getAttribute('data-photo-id');
        if (!id) return;
        const saved = JSON.parse(localStorage.getItem('photo-wall-' + id) || 'null');
        if (!saved || !Number.isFinite(saved.x) || !Number.isFinite(saved.y)) return;
        const scale = Number(card.style.getPropertyValue('--card-scale')) || 1;
        const width = cardWidth * scale;
        const verticalOffset = width < 250 ? width * 0.6 : 100;
        card.style.left = '50%';
        card.style.top = '50%';
        card.style.transform = 'translate3d(' + (saved.x - width / 2) + 'px, ' + (saved.y - verticalOffset) + 'px, 0) rotate(' + (Number(saved.rotation) || 0) + 'deg)';
      });
    } catch {}
  })();

  window.addEventListener('photo-wall-ready', () => {
    document.documentElement.classList.add('photo-wall-ready');
  }, { once: true });
</script>

<style>
  .font-handwriting {
    font-family: 'Caveat', 'Dancing Script', cursive;
  }

  :global(.photo-wall-container) {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .static-photo-wall {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    opacity: 1;
    transition: opacity 120ms ease;
  }

  :global(html.photo-wall-ready) .static-photo-wall {
    opacity: 0;
  }

  .photo-wall-runtime {
    position: relative;
    z-index: 2;
  }

  .static-photo-card {
    position: absolute;
    left: var(--left);
    top: var(--top);
    width: calc(360px * var(--card-scale));
    transform: rotate(var(--rotate));
  }

  .static-photo-frame {
    padding: 4px;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, .3), 0 4px 6px -2px rgba(0, 0, 0, .1);
  }

  .static-photo-frame img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    :global(.photo-card) { width: 150px !important; }
    .static-photo-card { width: calc(150px * var(--card-scale)); }
  }

  @media (max-width: 480px) {
    :global(.photo-card) { width: 120px !important; }
    .static-photo-card { width: calc(120px * var(--card-scale)); }
  }
</style>
