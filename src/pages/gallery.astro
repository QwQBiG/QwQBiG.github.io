---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/LightLayout.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import type { GalleryPhoto } from '../types/photo';
import firstLayout from '../scripts/gallery-first-layout.js?raw';
import { photoCardStyle, photoFrameHeightRatio, photoPreviewSize, photoWallBreakpoints, photoWallSizes } from '../utils/photo-wall';
import '../styles/gallery-positions.css';
import '../styles/gallery-entrance.css';
import '../styles/gallery-interactions.css';

const manifest = path.join(process.cwd(), 'public/generated/gallery/manifest.json');
const photos: GalleryPhoto[] = JSON.parse(readFileSync(manifest, 'utf8'));
// Leave room between photos, and cap the total stagger for larger collections.
const staggerMs = Math.min(160, 1600 / Math.max(1, photos.length - 1));
---

<Layout title="Gallery - QwQBiG's World" description="Drag photos around the gallery or select one for a closer look.">
  <Fragment slot="head">
    {photos[0] && <link rel="preload" as="image" type="image/avif"
      imagesrcset={photos[0].avifSrcset} imagesizes={photoWallSizes(photos[0].scale ?? 1)} fetchpriority="high" />}
    <script src="../scripts/gallery-page.ts"></script>
    <style is:inline set:html={photoWallBreakpoints()} />
    <script is:inline data-photo-ids={JSON.stringify(photos.map(photo => photo.id))} set:html={firstLayout} />
    <script is:inline>
      if (CSS.supports('width', '1cqw') && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const root = document.documentElement;
        root.dataset.galleryEntrance = '';
        // Start on schedule even if the first photos or the gallery script stall.
        setTimeout(() => { delete root.dataset.galleryEntrance; }, 1600);
      }
    </script>
  </Fragment>
  <FloatingNavCard />
  <main class="gallery-main flex-1 h-screen relative overflow-hidden">
    <div class="absolute inset-0 gradient-bg -z-10"></div>
    <div class="photo-wall" data-photo-wall>
      {photos.map((photo, index) => {
        const sizes = photoWallSizes(photo.scale ?? 1);
        return (
          <a
            class="photo-card"
            data-photo-id={photo.id}
            data-ratio={photoFrameHeightRatio(photo)}
            data-preview-width={photo.previewWidth}
            data-preview-height={photo.previewHeight}
            href={photo.preview}
            data-astro-prefetch="false"
            draggable="false"
            style={{
              ...photoCardStyle(photo, index, photos.length),
              '--deal-delay': `${index * staggerMs}ms`,
            }}
          >
            <div class="photo-pose">
              <div class="photo-frame">
                <div class="gallery-image" style={{ aspectRatio: `${photo.previewWidth} / ${photo.previewHeight}` }}>
                  <picture style={{ '--photo-placeholder': `url("${photo.placeholder}")` }}>
                    <source data-navigation-image type="image/avif" srcset={photo.avifSrcset} sizes={sizes} />
                    <img
                      srcset={photo.srcset} sizes={sizes} src={photo.thumb2x}
                      alt={photo.alt} width={photo.width} height={photo.height}
                      fetchpriority={index < 2 ? 'high' : 'auto'}
                      loading="eager" decoding="async" draggable="false"
                    />
                  </picture>
                  <img
                    data-gallery-full={photo.preview} data-srcset={photo.previewSrcset} alt="" aria-hidden="true"
                    sizes={`(width < 768px) ${photoPreviewSize(photo, true)}, ${photoPreviewSize(photo, false)}`}
                    width={photo.previewWidth} height={photo.previewHeight}
                    fetchpriority="low"
                    loading="eager" decoding="async" draggable="false"
                  />
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</Layout>
