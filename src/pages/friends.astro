---
import LightLayout from '../layouts/LightLayout.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import { friendSites, thisSite } from '../data/friends';

const siteDetails = `名称：${thisSite.name}\n网址：${thisSite.url}\n头像：${thisSite.avatar}`;
const hasExamples = friendSites.some((site) => site.example);
---

<LightLayout title="友链 - QwQBiG's World" description="友链与本站资料">
  <FloatingNavCard />

  <main class="friends-page">
    <div class="friends-layout">
      <section class="friends-collection" aria-labelledby="friends-title">
        <header class="friends-header">
          <p class="eyebrow">FRIENDS</p>
          <h1 id="friends-title">友链</h1>
        </header>

        <div class="collection-heading">
          <span>站点收藏</span>
          <span class="collection-rule" aria-hidden="true"></span>
        </div>

        <div class="friends-list">
          {friendSites.map((site) => (
            <a
              class="friend-card"
              href={site.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`访问${site.name}${site.example ? '（示例站点）' : ''}，在新窗口打开`}
            >
              <span class="friend-monogram" aria-hidden="true">{site.monogram}</span>
              <div class="friend-info">
                <div class="friend-title">
                  <h2>{site.name}</h2>
                  {site.example && <span class="example-badge">示例</span>}
                </div>
                <p class="friend-description">{site.description}</p>
                <span class="friend-domain">{new URL(site.url).hostname}</span>
              </div>
              <span class="external-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </span>
            </a>
          ))}
          {friendSites.length === 0 && <p class="empty-message">暂未添加友链。</p>}
        </div>
        {hasExamples && <p class="preview-note">卡片示例，尚未添加正式友链。</p>}
      </section>

      <aside class="site-card" aria-labelledby="site-card-title">
        <p class="site-card-label">本站名片</p>
        <div class="site-identity">
          <img class="site-avatar" src="/generated/site/avatar-160.webp" alt="iqwqi 的头像" width="56" height="56" decoding="async" />
          <div>
            <h2 id="site-card-title">{thisSite.name}</h2>
            <a class="site-address" href={thisSite.url}>{new URL(thisSite.url).hostname}</a>
          </div>
        </div>

        <button type="button" class="copy-button" data-copy-site data-copy-text={siteDetails}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="8" width="12" height="12" rx="2" />
            <path d="M16 8V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4" />
          </svg>
          <span data-copy-label>复制本站资料</span>
        </button>
        <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>

        <details class="site-details" data-site-details>
          <summary>
            <span>完整资料</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m7 10 5 5 5-5" /></svg>
          </summary>
          <dl>
            <div><dt>名称</dt><dd>{thisSite.name}</dd></div>
            <div><dt>网址</dt><dd>{thisSite.url}</dd></div>
            <div><dt>头像</dt><dd>{thisSite.avatar}</dd></div>
          </dl>
        </details>
      </aside>
    </div>
  </main>
</LightLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-site]');
  const copyLabel = document.querySelector<HTMLElement>('[data-copy-label]');
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  const siteDetails = document.querySelector<HTMLDetailsElement>('[data-site-details]');
  let resetTimer: ReturnType<typeof setTimeout>;

  copyButton?.addEventListener('click', async () => {
    const text = copyButton.dataset.copyText;
    if (!text || !copyStatus || !copyLabel) return;

    clearTimeout(resetTimer);
    try {
      await navigator.clipboard.writeText(text);
      copyLabel.textContent = '已复制';
      copyStatus.textContent = '本站资料已复制。';
    } catch {
      if (siteDetails) siteDetails.open = true;
      copyStatus.textContent = '可选中下方资料手动复制。';
    }
    resetTimer = setTimeout(() => {
      copyLabel.textContent = '复制本站资料';
      copyStatus.textContent = '';
    }, 3000);
  });
</script>

<style>
  .friends-page {
    flex: 1;
    padding: clamp(112px, 12vh, 156px) 32px 80px;
    color: #41364e;
  }

  .friends-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    align-items: start;
    gap: 48px;
    width: min(100%, 1100px);
    margin: 0 auto;
  }

  .friends-header { margin: 0 0 38px; }
  .eyebrow { color: #8c6c9a; font-size: 11px; font-weight: 600; letter-spacing: .19em; }
  .friends-header h1 { margin-top: 5px; font-size: clamp(30px, 3vw, 38px); line-height: 1.35; font-weight: 650; letter-spacing: .04em; }
  .collection-heading { display: flex; align-items: center; gap: 16px; margin: 0 2px 18px; color: #74667f; font-size: 13px; font-weight: 500; }
  .collection-rule { flex: 1; height: 1px; background: rgba(111, 82, 127, .15); }
  .friends-list { display: grid; gap: 14px; }

  .friend-card {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 34px;
    align-items: center;
    gap: 20px;
    min-height: 132px;
    padding: 22px 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .76);
    border-radius: 26px;
    background: linear-gradient(125deg, rgba(255, 255, 255, .64), rgba(255, 255, 255, .32));
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    box-shadow: 0 16px 32px -26px rgba(87, 58, 108, .4), inset 0 1px 0 rgba(255, 255, 255, .8);
    color: inherit;
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease, background-color .25s ease;
  }

  .friend-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(120deg, rgba(255, 255, 255, .4), transparent 48%);
    opacity: 0;
    transition: opacity .25s ease;
  }

  .friend-card:hover { transform: translateY(-3px); background-color: rgba(255, 255, 255, .18); box-shadow: 0 24px 36px -28px rgba(87, 58, 108, .48), inset 0 1px 0 rgba(255, 255, 255, .9); }
  .friend-card:hover::before { opacity: 1; }
  .friend-monogram { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border: 1px solid rgba(255, 255, 255, .8); border-radius: 18px; background: linear-gradient(145deg, rgba(217, 205, 241, .8), rgba(244, 222, 237, .7)); color: #806094; font-size: 25px; font-weight: 500; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .8); }
  .friend-info { min-width: 0; }
  .friend-title { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
  .friend-title h2 { font-size: 19px; line-height: 1.4; font-weight: 600; }
  .example-badge { padding: 1px 7px; border: 1px solid rgba(143, 111, 162, .22); border-radius: 6px; background: rgba(255, 255, 255, .26); color: #80618f; font-size: 10px; line-height: 1.6; white-space: nowrap; }
  .friend-description { margin-top: 5px; color: #66596f; font-size: 14px; line-height: 1.65; overflow-wrap: anywhere; }
  .friend-domain { display: inline-block; margin-top: 7px; color: #75637f; font-size: 12px; letter-spacing: .02em; overflow-wrap: anywhere; }
  .external-arrow { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1px solid rgba(255, 255, 255, .68); border-radius: 50%; background: rgba(255, 255, 255, .2); color: #8c6a9e; }
  .external-arrow svg { width: 17px; height: 17px; transition: transform .25s ease; }
  .friend-card:hover .external-arrow svg { transform: translate(2px, -2px); }
  .preview-note, .empty-message { margin: 16px 3px 0; color: #7c6c86; font-size: 12px; }

  .site-card {
    padding: 26px 24px 18px;
    border: 1px solid rgba(255, 255, 255, .7);
    border-radius: 26px;
    background: linear-gradient(145deg, rgba(255, 255, 255, .48), rgba(255, 255, 255, .24));
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    box-shadow: 0 20px 36px -32px rgba(87, 58, 108, .36), inset 0 1px 0 rgba(255, 255, 255, .78);
  }

  .site-card-label { margin-bottom: 20px; color: #776080; font-size: 12px; font-weight: 500; }
  .site-identity { display: grid; grid-template-columns: 56px minmax(0, 1fr); align-items: center; gap: 13px; }
  .site-avatar { display: block; width: 56px; height: 56px; border: 2px solid rgba(255, 255, 255, .85); border-radius: 18px; object-fit: cover; box-shadow: 0 8px 20px -14px rgba(87, 58, 108, .6); }
  .site-card h2 { font-size: 17px; line-height: 1.4; font-weight: 600; letter-spacing: -.025em; overflow-wrap: anywhere; }
  .site-address { display: inline-block; margin-top: 3px; color: #75617f; font-size: 13px; text-decoration: none; }
  .site-address:hover { color: #704981; }
  .copy-button { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 44px; margin-top: 24px; padding: 11px 14px; border: 1px solid rgba(255, 255, 255, .8); border-radius: 14px; background: rgba(255, 255, 255, .5); color: #755080; font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: 0 5px 12px -10px rgba(87, 58, 108, .3); transition: background-color .2s ease; }
  .copy-button:hover { background: rgba(255, 255, 255, .78); }
  .copy-button svg { width: 15px; height: 15px; }
  .copy-status { min-height: 18px; margin-top: 7px; color: #805b90; font-size: 11px; text-align: center; }
  .site-details { margin-top: 9px; border-top: 1px solid rgba(117, 89, 135, .12); }
  .site-details summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding: 10px 0 0; color: #75617f; font-size: 12px; list-style: none; cursor: pointer; }
  .site-details summary::-webkit-details-marker { display: none; }
  .site-details summary svg { width: 15px; height: 15px; transition: transform .2s ease; }
  .site-details[open] summary svg { transform: rotate(180deg); }
  .site-details dl { padding-top: 13px; }
  .site-details dl > div { padding: 7px 0; }
  .site-details dt { margin-bottom: 3px; color: #9a869f; font-size: 10px; }
  .site-details dd { overflow-wrap: anywhere; color: #6f5f7b; font-size: 12px; line-height: 1.6; user-select: text; -webkit-user-select: text; }
  .friend-card:focus-visible, .copy-button:focus-visible, .site-details summary:focus-visible, .site-address:focus-visible { outline: 2px solid #a779be; outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .friend-card, .friend-card::before, .external-arrow svg, .copy-button, .site-details summary svg { transition: none; }
    .friend-card:hover, .friend-card:hover .external-arrow svg { transform: none; }
  }

  @media (max-width: 800px) {
    .friends-page { padding: 110px 24px 56px; }
    .friends-layout { grid-template-columns: minmax(0, 1fr); gap: 38px; max-width: 620px; }
    .friends-header { margin-bottom: 28px; }
    .site-card { max-width: 100%; }
  }

  @media (max-width: 480px) {
    .friends-page { padding: 100px 18px 40px; }
    .friends-layout { gap: 32px; }
    .friend-card { grid-template-columns: 52px minmax(0, 1fr) 28px; gap: 14px; padding: 20px 19px; min-height: 124px; border-radius: 23px; }
    .friend-monogram { width: 52px; height: 52px; border-radius: 18px; font-size: 23px; }
    .friend-title { gap: 7px; }
    .friend-title h2 { font-size: 17px; }
    .friend-description { font-size: 13px; }
    .external-arrow { width: 28px; height: 28px; }
    .external-arrow svg { width: 15px; height: 15px; }
    .site-card { padding: 24px; }
  }
</style>
