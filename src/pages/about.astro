---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import FieldJournal from '../components/about/FieldJournal.astro';
import PrismBench from '../components/about/PrismBench.astro';
import ProcessArtifacts from '../components/about/ProcessArtifacts.astro';
import SyntaxLoom from '../components/about/SyntaxLoom.astro';
import WritingDesk from '../components/about/WritingDesk.astro';
import OpenDoor from '../components/about/OpenDoor.astro';
import '../styles/about-film.css';

const pageTitle = "关于 iqwqi — 一幅持续发生的自画像";
const pageDescription = 'iqwqi 的交互式数字自画像：在逻辑、文字与好奇心之间持续生长。';

const movements = [
  { no: '01', en: 'OBSERVE', zh: '观察', text: '先让熟悉的事物重新变得陌生。看见结构，也看见缝隙。' },
  { no: '02', en: 'MAKE', zh: '建造', text: '把模糊的念头拆成可以运行的零件，再把温度装回去。' },
  { no: '03', en: 'KEEP', zh: '留存', text: '把走过的路折叠成文字，留给下一次出发时的自己。' },
];

const materials = [
  ['C++', 'SYSTEM / PERFORMANCE'],
  ['RUST', 'SAFETY / STRUCTURE'],
  ['ASTRO', 'WEB / EXPRESSION'],
  ['LINUX', 'TOOLS / FREEDOM'],
  ['POETRY', 'MEMORY / FEELING'],
];

const doors = [
  { no: 'I', title: '计算机世界', note: '算法、语言、系统与实践', href: '/cs/' },
  { no: 'II', title: '诗与碎片', note: '那些不必运行的句子', href: '/poetry/' },
  { no: 'III', title: '时间归档', note: '沿时间翻阅全部记录', href: '/archives/' },
];
---

<Layout title={pageTitle} description={pageDescription} image="/ZhenXun.png" gradientBg={false}>
  <FloatingNavCard />
  <main class="about-film" data-about-film>
    <canvas class="living-paint" data-living-paint aria-hidden="true"></canvas>
    <canvas class="memory-thread" data-memory-thread aria-hidden="true"></canvas>
    <div class="film-surface" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="film-cursor" data-film-cursor aria-hidden="true"><i></i><b></b></div>
    <aside class="film-score" aria-hidden="true">
      <span>IQWQI / SELF PORTRAIT</span>
      <i><b data-film-progress></b></i>
      <em data-film-index>01 — 06</em>
    </aside>

    <section class="film-scene scene-prologue" data-film-scene data-scene="0" id="top">
      <div class="film-stage">
        <div class="depth-layer layer-atmosphere" data-depth="1" aria-hidden="true">
          <div class="journal-dust"><i></i><i></i><i></i><i></i><i></i></div>
          <p>PERSONAL STUDY · 2026</p>
        </div>
        <div class="depth-layer layer-landscape" data-depth="2" aria-hidden="true">
          <FieldJournal />
        </div>
        <div class="depth-layer layer-memory" data-depth="3" aria-hidden="true">
          <span class="memory-word">iqwqi</span><small>BETWEEN LOGIC &amp; WONDER</small>
        </div>
        <div class="depth-layer layer-subject" data-depth="4">
          <p class="scene-kicker" data-reveal>一幅正在发生的自画像</p>
          <h1 data-reveal><span>理性是骨骼，</span><span><em>感受</em>是光。</span></h1>
          <p class="hero-copy" data-reveal>你好，我是 <strong>iqwqi</strong>。我喜欢把世界拆开，看看它为何运行；也喜欢在一切安静以后，写几句不必运行的话。</p>
        </div>
        <div class="depth-layer layer-foreground" data-depth="5" aria-hidden="true">
          <span class="folio">NO. 001</span><span class="coordinates">31°N / ONLINE / GROWING</span>
          <a href="#premise" tabindex="-1">SCROLL TO ENTER <i>↓</i></a>
        </div>
      </div>
    </section>

    <section class="film-scene scene-premise" data-film-scene data-scene="1" id="premise">
      <div class="film-stage">
        <div class="depth-layer layer-atmosphere" data-depth="1" aria-hidden="true">
          <span class="light-seam"></span><p>00 / THE PREMISE</p>
        </div>
        <div class="depth-layer layer-landscape" data-depth="2" aria-hidden="true">
          <PrismBench />
        </div>
        <div class="depth-layer layer-memory" data-depth="3" aria-hidden="true">
          <span class="ampersand">＆</span><small>ONE MIND · TWO LANGUAGES</small>
        </div>
        <div class="depth-layer layer-subject" data-depth="4">
          <p class="scene-kicker" data-reveal>我所在的位置</p>
          <blockquote data-reveal>
            <span>我不在代码与诗之间。</span>
            <em>它们本来就是同一种好奇心，</em>
            <span>只是使用了不同的语法。</span>
          </blockquote>
        </div>
        <div class="depth-layer layer-foreground" data-depth="5" aria-hidden="true">
          <span class="edge-note">A THOUGHT BECOMES FORM</span><i class="moving-glint"></i>
        </div>
      </div>
    </section>

    <section class="film-scene scene-method" data-film-scene data-scene="2" id="method">
      <div class="film-stage">
        <div class="depth-layer layer-atmosphere" data-depth="1" aria-hidden="true">
          <div class="process-constellation"><i></i><i></i><i></i><i></i><i></i><i></i></div><p>01 / HOW I MOVE</p>
        </div>
        <div class="depth-layer layer-landscape" data-depth="2" aria-hidden="true">
          <ProcessArtifacts />
        </div>
        <div class="depth-layer layer-memory" data-depth="3" aria-hidden="true">
          <span class="memory-word">PROCESS</span><small>NO FIXED ROUTE</small>
        </div>
        <div class="depth-layer layer-subject" data-depth="4">
          <header class="method-heading" data-reveal>
            <p class="scene-kicker">一个念头，如何获得形状</p>
            <h2>靠近。拆解。<em>留下。</em></h2>
          </header>
          <div class="movement-sequence">
            {movements.map((movement, index) => (
              <article data-reveal data-object-trigger={index} tabindex="0">
                <span>{movement.no}</span><small>{movement.en}</small>
                <h3>{movement.zh}</h3><p>{movement.text}</p>
              </article>
            ))}
          </div>
        </div>
        <div class="depth-layer layer-foreground" data-depth="5" aria-hidden="true">
          <span class="method-rule"></span><p>APPROACH → BREAK → RECOMPOSE</p>
          <div class="process-near-dust"><i></i><i></i><i></i><i></i><i></i></div>
        </div>
      </div>
    </section>

    <section class="film-scene scene-materials" data-film-scene data-scene="3" id="materials">
      <div class="film-stage">
        <div class="depth-layer layer-atmosphere" data-depth="1" aria-hidden="true">
          <div class="code-rain"><i>010</i><i>7F</i><i>诗</i><i>101</i><i>&#123; &#125;</i></div><p>02 / MATERIALS</p>
        </div>
        <div class="depth-layer layer-landscape" data-depth="2" aria-hidden="true">
          <SyntaxLoom />
        </div>
        <div class="depth-layer layer-memory" data-depth="3" aria-hidden="true">
          <span class="memory-word">MATTER</span><small>THE THINGS I THINK WITH</small>
        </div>
        <div class="depth-layer layer-subject" data-depth="4">
          <header class="materials-heading" data-reveal>
            <p class="scene-kicker">我用什么塑造现在</p>
            <h2>工具会过时，<em>判断</em>留下来。</h2>
          </header>
          <ol class="material-ledger">
            {materials.map(([name, note], index) => (
              <li data-reveal data-material-trigger={index} tabindex="0"><span>0{index + 1}</span><strong>{name}</strong><small>{note}</small></li>
            ))}
          </ol>
        </div>
        <div class="depth-layer layer-foreground" data-depth="5" aria-hidden="true">
          <span class="scan-beam"></span><p>LANGUAGE IS A LENS, NOT A CAGE.</p>
          <div class="syntax-near"><i></i><i></i><i></i></div>
        </div>
      </div>
    </section>

    <section class="film-scene scene-words" data-film-scene data-scene="4" id="words">
      <div class="film-stage">
        <div class="depth-layer layer-atmosphere" data-depth="1" aria-hidden="true">
          <span class="paper-moon"></span><div class="ink-motes"><i></i><i></i><i></i></div><p>03 / AFTER LOGIC</p>
        </div>
        <div class="depth-layer layer-landscape" data-depth="2" aria-hidden="true">
          <WritingDesk />
        </div>
        <div class="depth-layer layer-memory" data-depth="3" aria-hidden="true">
          <span class="memory-word">未编译</span><small>WORDS THAT DO NOT NEED TO RUN</small>
        </div>
        <div class="depth-layer layer-subject" data-depth="4">
          <p class="scene-kicker" data-reveal>当屏幕安静下来</p>
          <div class="poem" data-reveal>
            <p>有些话不解决问题，</p>
            <p>只负责在夜里发一点光。</p>
            <p>我把它们写下，</p>
            <p><em>免得自己走得太快。</em></p>
          </div>
          <a class="text-link" href="/poetry/" data-reveal>读诗与碎片 <span>↗</span></a>
        </div>
        <div class="depth-layer layer-foreground" data-depth="5" aria-hidden="true">
          <span class="rain-streak streak-a"></span><span class="rain-streak streak-b"></span>
          <div class="loose-words"><i>风</i><i>光</i><i>未完成</i><i>记忆</i></div>
          <p>A SOFT PLACE FOR UNFINISHED THOUGHTS</p>
        </div>
      </div>
    </section>

    <section class="film-scene scene-epilogue" data-film-scene data-scene="5" id="epilogue">
      <div class="film-stage">
        <div class="depth-layer layer-atmosphere" data-depth="1" aria-hidden="true">
          <div class="dawn-motes"><i></i><i></i><i></i><i></i><i></i></div><p>04 / CONTINUE</p>
        </div>
        <div class="depth-layer layer-landscape" data-depth="2" aria-hidden="true">
          <OpenDoor />
        </div>
        <div class="depth-layer layer-memory" data-depth="3" aria-hidden="true">
          <span class="memory-word">NEXT</span><small>THE PORTRAIT REMAINS UNFINISHED</small>
        </div>
        <div class="depth-layer layer-subject" data-depth="4">
          <header class="epilogue-heading" data-reveal>
            <p class="scene-kicker">自画像没有完成时</p>
            <h2>继续认识，<br /><em>继续成为。</em></h2>
          </header>
          <nav class="doorways" aria-label="继续浏览">
            {doors.map((door, index) => (
              <a href={door.href} data-reveal data-door-trigger={index}>
                <span>{door.no}</span><strong>{door.title}</strong><small>{door.note}</small><i>↗</i>
              </a>
            ))}
          </nav>
        </div>
        <div class="depth-layer layer-foreground" data-depth="5">
          <div class="signature" data-reveal>
            <small>WRITTEN, BUILT &amp; KEPT BY</small><strong>iqwqi</strong>
            <p><a href="https://github.com/QwQBiG" target="_blank" rel="noopener noreferrer">GitHub</a><i></i><a href="https://space.bilibili.com/3546921071282890" target="_blank" rel="noopener noreferrer">Bilibili</a><i></i><a href="https://leetcode.cn/u/iqwqi/" target="_blank" rel="noopener noreferrer">LeetCode</a></p>
          </div>
          <a class="return-top" href="#top">RETURN TO LIGHT ↑</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/about-film';
</script>
