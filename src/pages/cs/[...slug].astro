---
import { readingListPrefetch } from '../../utils/content-navigation';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/layout/Footer.astro';
import FloatingNavCard from '../../components/layout/FloatingNavCard.astro';
import GlassContainer from '../../components/ui/GlassContainer.astro';
import ArticleBody from '../../components/content/ArticleBody.astro';
import { render } from 'astro:content';
import { formatDisplayDate } from '../../utils/date';
import { loadContent } from '../../utils/load-content';
import { getPostTags, getTagKey, isSeriesEntry } from '../../utils/content';
import WalineComments from '../../components/WalineComments.astro';

export async function getStaticPaths() {
  const { publishedCS: posts } = await loadContent();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(heading => heading.depth <= 3);

const { title, description, date, series, hidden } = post.data;
const tags = getPostTags(post);

// Get related posts (same series or similar tags)
const content = await loadContent();
const allPosts = content.csPosts;
const currentSlug = post.slug;

// 判断是否是合集页面（categories 包含 "合集"）
const isSeriesCollection = isSeriesEntry(post);

// 如果是合集页面，获取该合集下的所有文章
let collectionPosts: typeof allPosts = [];
if (isSeriesCollection) {
  collectionPosts = allPosts.filter(p =>
    p.data.series?.includes(title) &&
    p.slug !== currentSlug
  ).sort((a, b) => (a.data.weight || 0) - (b.data.weight || 0) || a.data.date.getTime() - b.data.date.getTime());
}

// Find prev/next posts in the same series
let seriesPosts: typeof allPosts = [];
if (series && series.length > 0) {
  seriesPosts = allPosts.filter(p =>
    p.data.series?.some(s => series.includes(s))
  ).sort((a, b) => (a.data.weight || 0) - (b.data.weight || 0) || a.data.date.getTime() - b.data.date.getTime());
}

const currentIndex = seriesPosts.findIndex(p => p.slug === currentSlug);
const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex >= 0 && currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;

const pageTitle = `${title} - QwQBiG's World`;
---

<Layout
  title={pageTitle}
  description={description}
  type="article"
  noIndex={hidden}
>
  <FloatingNavCard />

  <main class="flex-1 py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        {/* Main Content */}
        <article class="min-w-0 lg:col-span-9">
          <GlassContainer padding="reading">
          {/* Post Header */}
          <header class="mb-8 max-sm:[overflow-wrap:anywhere]">
            {series && series.length > 0 && !isSeriesCollection && (
              <div class="flex flex-wrap gap-2 mb-4">
                {series.map((s) => (
                  <a
                    href={content.series.find(entry => entry.title === s) ? `/cs/${content.series.find(entry => entry.title === s)!.slug}/` : '/series/'}
                    class="inline-flex items-center gap-1 px-3 py-1 text-sm font-medium text-primary bg-primary/10 rounded-full hover:bg-primary/20 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                    </svg>
                    {s}
                  </a>
                ))}
              </div>
            )}

            <h1 class="font-sans font-bold text-3xl md:text-4xl text-text-primary mb-4 leading-tight">
              {title}
            </h1>

            <div class="flex flex-wrap items-center gap-4 text-sm text-text-secondary">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <time datetime={date.toISOString()}>{formatDisplayDate(date)}</time>
              </span>

              {tags && tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag) => {
                    const href = content.tagUrls.get(getTagKey(tag));
                    return href ? (
                      <a href={href} class="text-primary hover:text-primary-dark transition-colors">#{tag}</a>
                    ) : (
                      <span class="text-primary">#{tag}</span>
                    );
                  })}
                </div>
              )}
            </div>
          </header>

          {tocHeadings.length > 0 && (
            <details class="toc article-mobile-toc lg:hidden" data-mobile-toc>
              <summary class="toc-title">Contents</summary>
              <a href="#article:contents" data-toc-fallback data-astro-reload>View full table of contents</a>
            </details>
          )}

          {/* Post Content */}
          <ArticleBody>
            <Content />
          </ArticleBody>

          {/* 合集文章列表 */}
          {isSeriesCollection && collectionPosts.length > 0 && (
            <div class="mt-12 pt-8 border-t border-border-color">
              <h2 class="text-2xl font-bold text-text-primary mb-6">Posts in this series</h2>
              <div class="space-y-4">
                {collectionPosts.map((collectionPost, index) => (
                  <a
                    href={`/cs/${collectionPost.slug}/`}
                    data-astro-prefetch={readingListPrefetch(index)}
                    class="group flex items-center gap-4 p-4 bg-bg-secondary rounded-xl border border-border-color hover:border-primary/30 transition-all"
                  >
                    <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">
                      {collectionPost.data.weight > 0 ? collectionPost.data.weight : index + 1}
                    </span>
                    <div class="flex-1 min-w-0">
                      <h3 class="font-medium text-text-primary group-hover:text-primary transition-colors line-clamp-1">
                        {collectionPost.data.title}
                      </h3>
                      {collectionPost.data.description && (
                        <p class="text-sm text-text-secondary line-clamp-1 mt-1">
                          {collectionPost.data.description}
                        </p>
                      )}
                    </div>
                    <svg class="w-5 h-5 text-text-muted group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          )}

          {/* Post Navigation */}
          {(prevPost || nextPost) && !isSeriesCollection && (
            <nav data-post-navigation class="mt-12 pt-8 border-t border-border-color">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {prevPost ? (
                  <a
                    href={`/cs/${prevPost.slug}/`}
                    rel="prev"
                    data-astro-prefetch="hover"
                    class="group p-4 bg-bg-secondary rounded-xl border border-border-color hover:border-primary/30 transition-all"
                  >
                    <span class="text-xs text-text-muted uppercase tracking-wide">Previous post</span>
                    <div class="font-medium text-text-primary group-hover:text-primary transition-colors line-clamp-2 mt-1">
                      {prevPost.data.title}
                    </div>
                  </a>
                ) : (
                  <div></div>
                )}

                {nextPost ? (
                  <a
                    href={`/cs/${nextPost.slug}/`}
                    rel="next"
                    data-astro-prefetch="viewport"
                    class="group p-4 bg-bg-secondary rounded-xl border border-border-color hover:border-primary/30 transition-all text-right md:text-left md:ml-auto"
                  >
                    <span class="text-xs text-text-muted uppercase tracking-wide">Next post</span>
                    <div class="font-medium text-text-primary group-hover:text-primary transition-colors line-clamp-2 mt-1">
                      {nextPost.data.title}
                    </div>
                  </a>
                ) : (
                  <div></div>
                )}
              </div>
            </nav>
          )}
          </GlassContainer>

          <GlassContainer padding="reading" class="mt-8">
            <WalineComments path={Astro.url.pathname} />
          </GlassContainer>
         </article>

        {/* Sidebar */}
        <aside class="lg:col-span-3">
          <div class="sticky top-24 space-y-6">
            {/* TOC */}
            {tocHeadings.length > 0 && (
              <div class="toc" id="article:contents" data-toc-sidebar>
                <div class="toc-title">Contents</div>
                <nav aria-label="Table of contents" data-article-toc>
                  <ul>
                    {tocHeadings.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.slug}`}
                          data-astro-reload
                          class={`h${heading.depth}`}
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            )}

            {/* Series Navigation */}
            {seriesPosts.length > 0 && !isSeriesCollection && (
              <div class="toc">
                <div class="toc-title">In this series</div>
                <ul>
                  {seriesPosts.map((seriesPost) => (
                    <li>
                      <a
                        href={`/cs/${seriesPost.slug}/`}
                        class:list={[
                          'block py-1 text-sm transition-colors',
                          seriesPost.slug === currentSlug
                            ? 'text-primary font-medium'
                            : 'text-text-secondary hover:text-primary'
                        ]}
                      >
                        {seriesPost.data.weight > 0 && `${seriesPost.data.weight}. `}
                        {seriesPost.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import '../../scripts/article-toc';

  document.addEventListener('click', event => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element && event.target.closest('[data-article-toc] a');
    const mobile = link && link.closest<HTMLDetailsElement>('[data-mobile-toc]');
    if (mobile) mobile.open = false;
  });
</script>

<style>
  [data-toc-sidebar] {
    scroll-margin-top: 6rem;
  }

  @media (max-width: 1023px) {
    .toc.article-mobile-toc {
      position: static;
      max-height: none;
      margin: 0 0 1.5rem;
      padding: 0 1rem;
    }

    .article-mobile-toc summary {
      margin: 0;
      padding-block: 0.65rem;
      cursor: pointer;
    }

    .article-mobile-toc [data-article-toc] {
      max-height: min(50vh, 24rem);
      overflow-y: auto;
      padding-bottom: 0.5rem;
    }

    .article-mobile-toc [data-article-toc] a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
