        <path class="journal-page-leaf page-leaf-back" d="M188 108L602 137L623 690L210 739Z" fill="none" stroke="#dfcbd8" stroke-opacity=".55" />
        <path class="journal-page-leaf page-leaf-front" d="M191 119L600 148L620 676L215 726Z" fill="none" stroke="#f0dce7" stroke-opacity=".7" />
        <g class="journal-ruling" stroke="#b99fbb" stroke-opacity=".25" stroke-width="2">
          <path d="M257 263L554 279" /><path d="M258 311L556 326" /><path d="M260 359L558 373" />
          <path d="M262 407L560 421" /><path d="M264 455L562 468" /><path d="M266 503L564 515" />
        </g>
        <path d="M282 208C358 178 470 185 538 223" fill="none" stroke="#e95d91" stroke-opacity=".38" stroke-width="3" stroke-linecap="round" />

        <g class="journal-index-tabs">
          <path d="M603 235L648 239L651 302L606 299Z" fill="#ff91b4" fill-opacity=".78" />
          <path d="M607 333L651 335L654 397L610 396Z" fill="#b59de5" fill-opacity=".76" />
          <path d="M611 431L655 432L658 494L614 494Z" fill="#8fbbe8" fill-opacity=".7" />
          <path d="M606 239L612 299M610 337L616 395M614 434L620 493" stroke="#fff" stroke-opacity=".4" stroke-width="3" />
        </g>

        <g class="journal-page-cue">
          <rect x="337" y="623" width="222" height="38" rx="13" fill="#fff8fc" fill-opacity=".3" stroke="#fff" stroke-opacity=".5" />
          <circle cx="358" cy="642" r="5" fill="#ec4e83" />
          <text x="376" y="647" fill="#5a495f" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="3">PRESS · CLOSE NOTES</text>
        </g>
      </g>

      <g class="journal-open-cover">
        <path class="open-cover-shadow" d="M177 105L-38 171Q-52 177-48 199L-7 720Q-4 742 18 748L181 728Z" fill="#4a3153" fill-opacity=".22" />
        <path class="open-cover-surface" d="M176 96L-44 162Q-57 168-53 190L-12 708Q-10 731 12 737L180 721Z" fill="url(#journal-cover)" stroke="#fff" stroke-opacity=".82" stroke-width="3" />
        <path d="M-31 184L158 125L170 686L6 719Z" fill="#fff" fill-opacity=".1" stroke="#fff" stroke-opacity=".3" stroke-width="2" />
        <path d="M-20 220L150 169M-16 273L152 219M-12 326L154 269" stroke="#fff" stroke-opacity=".24" stroke-width="3" stroke-linecap="round" />
        <path class="open-cover-outer-edge" d="M-44 164L-11 708Q-9 729 12 736" fill="none" stroke="#fff" stroke-opacity=".54" stroke-width="8" stroke-linecap="round" />
        <path d="M-4 705L177 687" fill="none" stroke="#b48bc3" stroke-opacity=".3" stroke-width="6" stroke-linecap="round" />
        <path class="open-cover-spine" d="M176 100L180 721" stroke="#fff" stroke-opacity=".68" stroke-width="7" stroke-linecap="round" />
      </g>

      <g class="journal-cover">
        <path d="M157 91Q160 62 190 64L582 93Q608 95 610 122L635 678Q637 704 609 708L207 752Q180 755 177 727Z" fill="url(#journal-cover)" stroke="#fff" stroke-opacity=".9" stroke-width="3" filter="url(#journal-grain)" />
        <path d="M185 116L205 716" fill="none" stroke="#fff" stroke-opacity=".52" stroke-width="3" />
        <path d="M212 102L229 706" fill="none" stroke="#d95b8d" stroke-opacity=".24" stroke-width="2" />
        <path d="M189 84L584 113" fill="none" stroke="#fff" stroke-opacity=".68" stroke-width="4" stroke-linecap="round" />
        <path d="M607 127L631 673" fill="none" stroke="#bd94c7" stroke-opacity=".3" stroke-width="5" stroke-linecap="round" />

        <g class="journal-label">
          <path d="M281 214Q284 196 302 197L532 210Q550 212 551 230L558 376Q559 395 540 396L310 405Q291 406 290 387Z" fill="#fff9fc" fill-opacity=".67" stroke="#fff" stroke-opacity=".88" stroke-width="2" />
          <text x="320" y="260" fill="#4a394e" font-family="JetBrains Mono, monospace" font-size="14" letter-spacing="4">PERSONAL FIELD NOTES</text>
          <text x="316" y="330" fill="#2b2430" font-family="Georgia, serif" font-size="61" font-style="italic">iqwqi</text>
          <path d="M319 354H505" stroke="#e94f85" stroke-width="3" />
          <text x="319" y="381" fill="#76677b" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="3">VOL. 001 · GROWING</text>
        </g>

        <path class="journal-sheen" d="M248 145L570 168" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="5" stroke-linecap="round" />

        <g class="journal-interaction-cue">
          <rect x="294" y="638" width="220" height="38" rx="13" fill="#fff8fc" fill-opacity=".26" stroke="#fff" stroke-opacity=".46" />
          <circle cx="315" cy="657" r="5" fill="#ec4e83" />
          <text class="cue-closed" x="333" y="662" fill="#5a495f" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="3">PRESS · OPEN NOTES</text>
        </g>

        <g class="journal-corner" fill="url(#journal-metal)" opacity=".82">
          <path d="M179 92Q182 67 207 68L250 71L251 91L205 88Q198 88 198 97L201 144L181 143Z" />
          <path d="M590 637L632 633L635 678Q637 702 611 706L570 710L568 689L610 685Q616 684 615 676L611 639Z" />
        </g>
      </g>

      <g class="journal-rings" fill="none" stroke="url(#journal-metal)" stroke-width="10" stroke-linecap="round">
        <path d="M156 151C112 148 111 215 157 211" /><path d="M160 234C116 231 116 298 163 294" />
        <path d="M164 317C120 314 120 381 167 377" /><path d="M168 400C124 397 124 464 171 460" />
        <path d="M172 483C128 480 128 547 175 543" /><path d="M176 566C132 563 132 630 179 626" />
      </g>

      <g class="journal-strap">
        <path class="elastic-back" d="M557 96L612 101L614 123L560 117ZM580 696L628 690L631 713L558 724Z" fill="#9e3f70" fill-opacity=".52" />
        <path class="elastic-front" d="M530 101L560 104L585 714L554 718Z" fill="url(#journal-ribbon)" opacity=".9" />
        <path class="elastic-highlight" d="M539 104L549 105L575 713L564 715Z" fill="#fff" opacity=".27" />
        <path class="elastic-wrap elastic-wrap-top" d="M530 101Q543 90 558 96L612 101" fill="none" stroke="#ff83ad" stroke-opacity=".82" stroke-width="8" stroke-linecap="round" />
        <path class="elastic-wrap elastic-wrap-bottom" d="M554 718Q570 729 588 719L628 713" fill="none" stroke="#ff83ad" stroke-opacity=".82" stroke-width="8" stroke-linecap="round" />
        <path class="elastic-release-cord" pathLength="1" d="M545 103C620 137 644 211 637 311C629 426 660 589 570 719" fill="none" stroke="url(#journal-ribbon)" stroke-opacity=".9" stroke-width="13" stroke-linecap="round" />
        <rect class="elastic-grip" x="542" y="477" width="43" height="68" rx="16" fill="#fff8fc" fill-opacity=".32" stroke="#fff" stroke-opacity=".65" stroke-width="2" transform="rotate(-3 542 477)" />
      </g>

      <g class="journal-bookmarks">
        <path d="M397 736L425 733L432 820L417 803L403 824Z" fill="#ec4e83" opacity=".88" />
        <path d="M447 731L470 729L476 791L464 780L453 793Z" fill="#9277d0" opacity=".72" />
      </g>
    </g>
  </svg>
</div>
