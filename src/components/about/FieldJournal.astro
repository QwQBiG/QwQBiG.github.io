<div
  class="field-journal"
  data-interactive-object
  data-interaction="journal"
  data-object-strength="0.34"
  role="button"
  tabindex="0"
  aria-pressed="false"
  aria-label="打开或合上一本贴有 iqwqi 标签的半透明手账"
>
  <svg viewBox="0 0 760 880" aria-hidden="true">
    <defs>
      <linearGradient id="journal-cover" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fff8fc" stop-opacity=".82" />
        <stop offset=".46" stop-color="#f5b7d1" stop-opacity=".62" />
        <stop offset="1" stop-color="#9c84d5" stop-opacity=".34" />
      </linearGradient>
      <linearGradient id="journal-paper" x1="0" y1="0" x2=".9" y2="1">
        <stop offset="0" stop-color="#fffefd" />
        <stop offset=".72" stop-color="#fff2f7" />
        <stop offset="1" stop-color="#eadcf0" />
      </linearGradient>
      <linearGradient id="journal-edge" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#d7c5dc" />
        <stop offset=".48" stop-color="#fff9fc" />
        <stop offset="1" stop-color="#cdb8d5" />
      </linearGradient>
      <linearGradient id="journal-metal" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fff" />
        <stop offset=".35" stop-color="#c9bfd2" />
        <stop offset=".68" stop-color="#fff6fb" />
        <stop offset="1" stop-color="#8e7f98" />
      </linearGradient>
      <linearGradient id="journal-ribbon" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ff7aa9" />
        <stop offset="1" stop-color="#c43f79" />
      </linearGradient>
      <filter id="journal-shadow" x="-40%" y="-40%" width="180%" height="200%">
        <feGaussianBlur stdDeviation="24" />
      </filter>
      <filter id="journal-soft" x="-25%" y="-25%" width="150%" height="150%">
        <feDropShadow dx="0" dy="18" stdDeviation="17" flood-color="#4a294f" flood-opacity=".22" />
      </filter>
      <filter id="journal-grain" x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="fractalNoise" baseFrequency=".72" numOctaves="2" seed="17" result="noise" />
        <feColorMatrix in="noise" type="saturate" values="0" result="mono" />
        <feComponentTransfer in="mono" result="faint">
          <feFuncA type="table" tableValues="0 .035" />
        </feComponentTransfer>
        <feBlend in="SourceGraphic" in2="faint" mode="multiply" />
      </filter>
    </defs>

    <ellipse class="journal-cast-shadow" cx="404" cy="786" rx="255" ry="49" fill="#472d50" opacity=".3" filter="url(#journal-shadow)" />

    <g class="journal-object" filter="url(#journal-soft)">
      <path class="journal-back-cover" d="M151 111Q154 78 188 73L604 105Q632 108 635 139L663 708Q665 741 632 749L210 804Q175 808 171 773Z" fill="#70567c" opacity=".42" />

      <g class="journal-strap-behind" fill="none" stroke-linecap="round">
        <path class="elastic-back-shadow" d="M585 110C650 113 681 159 677 231C670 356 698 541 660 649C647 688 621 709 588 716" stroke="#6f3158" stroke-opacity=".34" stroke-width="25" />
        <path class="elastic-back-loop" d="M585 110C650 113 681 159 677 231C670 356 698 541 660 649C647 688 621 709 588 716" stroke="url(#journal-ribbon)" stroke-opacity=".86" stroke-width="17" />
        <path class="elastic-back-shine" d="M588 111C646 118 669 162 665 232C659 359 686 538 649 643" stroke="#fff" stroke-opacity=".28" stroke-width="4" />
      </g>

      <path class="journal-paper-depth" d="M179 109L601 135L625 718L210 771Z" fill="url(#journal-edge)" stroke="#fff" stroke-opacity=".65" stroke-width="3" />
      <path d="M603 151L625 718L609 724L585 158Z" fill="#b9a6c4" opacity=".45" />
      <path d="M210 752L625 700L625 718L210 771Z" fill="#cbb9d2" opacity=".7" />

      <g class="journal-pages">
