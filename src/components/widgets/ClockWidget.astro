---
// ClockWidget.astro - 重新设计的数字时钟组件
---

<home-clock class="clock-widget w-full h-full flex flex-col items-center justify-center relative">
  {/* 装饰性背景圆环 */}
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-24 h-24 md:w-28 md:h-28 rounded-full border border-white/20 opacity-50"></div>
    <div class="absolute w-20 h-20 md:w-24 md:h-24 rounded-full border border-white/10 opacity-30"></div>
  </div>
  
  {/* 时间显示区域 */}
  <div class="time-display relative flex items-baseline gap-1 z-10">
    <span id="clock-time" class="clock-digits">00:00</span>
    <span id="clock-seconds" class="clock-seconds">:00</span>
  </div>
  
  {/* 日期显示 */}
  <div id="clock-date" class="clock-date mt-2 md:mt-3 text-center px-2 z-10">
    Loading…
  </div>
  
  {/* 装饰性指示点 */}
  <div class="flex gap-1.5 mt-3 z-10">
    <span class="w-1.5 h-1.5 rounded-full bg-gradient-to-br from-purple-400 to-pink-400 opacity-80"></span>
    <span class="w-1.5 h-1.5 rounded-full bg-gradient-to-br from-blue-400 to-cyan-400 opacity-60"></span>
    <span class="w-1.5 h-1.5 rounded-full bg-gradient-to-br from-amber-400 to-orange-400 opacity-40"></span>
  </div>
</home-clock>

<style>

  .clock-widget {
    font-family: 'Cascadia Mono', 'SF Mono', Consolas, monospace;
    /* 禁用光标和选择 */
    caret-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }
  
  .time-display {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }
  
  .clock-digits {
    font-size: clamp(1.75rem, 8vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    /* 紫粉渐变文字效果 */
    background: linear-gradient(
      135deg,
      #8B5CF6 0%,
      #EC4899 50%,
      #F472B6 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    /* 微妙的文字阴影增加深度 */
    filter: drop-shadow(0 2px 4px rgba(139, 92, 246, 0.2));
    line-height: 1;
    white-space: nowrap;
  }

  .clock-seconds {
    font-size: clamp(0.875rem, 4vw, 1.5rem);
    font-weight: 400;
    /* 蓝青渐变 */
    background: linear-gradient(
      135deg,
      #3B82F6 0%,
      #06B6D4 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    opacity: 0.9;
  }

  .clock-date {
    font-family: 'Segoe UI', system-ui, sans-serif;
    font-size: clamp(0.65rem, 3vw, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    /* 深灰紫色调 */
    color: rgba(107, 114, 128, 0.9);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  /* 秒数闪烁动画 */
  @keyframes pulse-soft {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0.5; }
  }
  
  .clock-seconds {
    animation: pulse-soft 2s ease-in-out infinite;
  }
  home-clock:not([data-ticking]) .clock-seconds {
    animation-play-state: paused;
  }
</style>

<script>
  const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const pad = (value: number) => String(value).padStart(2, '0');

  class HomeClock extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      const time = this.querySelector<HTMLElement>('#clock-time')!;
      const seconds = this.querySelector<HTMLElement>('#clock-seconds')!;
      const date = this.querySelector<HTMLElement>('#clock-date')!;
      const lifetime = new AbortController();
      const options = { signal: lifetime.signal };
      let visible = !('IntersectionObserver' in window);
      let suspended = false;
      let timer: number | undefined;

      function paint(now: Date) {
        const hhmm = pad(now.getHours()) + ':' + pad(now.getMinutes());
        const ss = ':' + pad(now.getSeconds());
        const day = weekdays[now.getDay()] + ', ' + months[now.getMonth()] + ' ' + pad(now.getDate());
        if (time.textContent !== hhmm) time.textContent = hhmm;
        if (seconds.textContent !== ss) seconds.textContent = ss;
        if (date.textContent !== day) date.textContent = day;
      }

      function tick() {
        const now = new Date();
        paint(now);
        timer = window.setTimeout(tick, 1000 - now.getMilliseconds());
      }

      const sync = () => {
        const ticking = visible && !document.hidden && !suspended;
        this.toggleAttribute('data-ticking', ticking);
        if (ticking && timer === undefined) tick();
        if (!ticking) {
          window.clearTimeout(timer);
          timer = undefined;
        }
      };

      // Populate the initial card even before the first intersection notification.
      paint(new Date());
      const observer = 'IntersectionObserver' in window ? new IntersectionObserver(([entry]) => {
        if (lifetime.signal.aborted) return;
        visible = entry.isIntersecting;
        sync();
      }) : undefined;
      observer?.observe(this);
      document.addEventListener('visibilitychange', sync, options);
      window.addEventListener('pagehide', () => { suspended = true; sync(); }, options);
      window.addEventListener('pageshow', () => { suspended = false; sync(); }, options);
      sync();

      this.dispose = () => {
        suspended = true;
        lifetime.abort();
        observer?.disconnect();
        sync();
      };
    }

    disconnectedCallback() {
      this.dispose?.();
    }
  }

  if (!customElements.get('home-clock')) customElements.define('home-clock', HomeClock);
</script>
