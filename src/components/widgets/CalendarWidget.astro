---
// CalendarWidget.astro - 优化版迷你日历组件
---

<home-calendar class="calendar-widget w-full h-full flex flex-col" style="position: relative; z-index: 50;">
  {/* 月份标题 */}
  <div class="calendar-header flex items-center justify-between mb-2 md:mb-3" style="position: relative; z-index: 51;">
    <button id="prev-month" type="button" aria-label="Previous month" class="calendar-nav-btn p-1.5 rounded-lg hover:bg-white/50 transition-colors flex-shrink-0" style="position: relative; z-index: 100; pointer-events: auto; cursor: pointer;">
      <svg class="w-3 h-3 md:w-4 md:h-4 text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    <span id="calendar-month-year" class="calendar-title text-xs md:text-sm font-semibold tracking-wide text-center flex-1 px-1 truncate"></span>
    <button id="next-month" type="button" aria-label="Next month" class="calendar-nav-btn p-1.5 rounded-lg hover:bg-white/50 transition-colors flex-shrink-0" style="position: relative; z-index: 100; pointer-events: auto; cursor: pointer;">
      <svg class="w-3 h-3 md:w-4 md:h-4 text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>
  
  {/* 星期标题 */}
  <div class="calendar-weekdays grid grid-cols-7 gap-0.5 md:gap-1 mb-1 md:mb-2">
    {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((day) => (
      <div class="calendar-weekday text-center text-[10px] md:text-xs font-medium py-0.5 font-['Cormorant_Garamond']">
        {day}
      </div>
    ))}
  </div>
  
  {/* 日期网格 */}
  <div id="calendar-days" class="calendar-days grid grid-cols-7 gap-0.5 md:gap-1 flex-1">
    {/* 由 JS 动态生成 */}
  </div>
</home-calendar>

<style is:global>
  /* 日历组件样式 - 使用 is:global 确保动态生成的元素也能应用样式 */
  .calendar-widget {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    /* 禁用光标和选择 */
    caret-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }
  
  .calendar-nav-btn {
    transition: all 0.2s ease;
  }
  
  .calendar-nav-btn:hover {
    background: rgba(255, 255, 255, 0.6);
    transform: scale(1.05);
  }
  
  .calendar-nav-btn:active {
    transform: scale(0.95);
  }
  
  /* 月份标题 - 紫粉渐变 */
  .calendar-title {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.9) 0%, rgba(236, 72, 153, 0.85) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  /* 星期标题 - 柔和的紫灰色 */
  .calendar-weekday {
    color: rgba(139, 92, 246, 0.5);
    font-weight: 600;
  }
  
  .calendar-day {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(0.65rem, 1.5vw, 0.85rem);
    font-weight: 600;
    /* 本月日期 - 使用与时钟日期相同的灰色 */
    color: rgba(107, 114, 128, 0.9);
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    min-height: 1.5rem;
    min-width: 1.5rem;
  }
  
  .calendar-day:hover:not(.today):not(.other-month) {
    background: rgba(255, 255, 255, 0.7);
    transform: scale(1.1);
    box-shadow: 0 2px 8px rgba(139, 92, 246, 0.15);
  }
  
  /* 非本月日期 - 极淡的灰色，几乎看不见 */
  .calendar-day.other-month {
    color: rgba(156, 163, 175, 0.25) !important;
    cursor: default;
    font-weight: 400;
  }
  
  .calendar-day.other-month:hover {
    background: transparent;
    transform: none;
    box-shadow: none;
  }
  
  /* 周末日期 - 淡紫色 */
  .calendar-day.weekend {
    color: rgba(139, 92, 246, 0.75) !important;
    font-weight: 600;
  }
  
  /* 今天的特殊样式 - 紫粉渐变，更精致 */
  .calendar-day.today {
    background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%) !important;
    color: white !important;
    font-weight: 600;
    box-shadow: 
      0 3px 10px rgba(167, 139, 250, 0.35),
      inset 0 1px 1px rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }
  
  .calendar-day.today:hover {
    transform: translateY(-1px) scale(1.08);
    box-shadow: 
      0 5px 14px rgba(167, 139, 250, 0.45),
      inset 0 1px 1px rgba(255, 255, 255, 0.4);
  }
</style>

<script>
  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  class HomeCalendar extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      const title = this.querySelector<HTMLElement>('#calendar-month-year')!;
      const days = this.querySelector<HTMLElement>('#calendar-days')!;
      const previous = this.querySelector<HTMLButtonElement>('#prev-month')!;
      const next = this.querySelector<HTMLButtonElement>('#next-month')!;
      const lifetime = new AbortController();
      const options = { signal: lifetime.signal };
      let today = new Date();
      let month = today.getMonth();
      let suspended = false;
      let midnightTimer: number | undefined;

      function render() {
        const year = today.getFullYear();
        title.textContent = `${monthNames[month]} ${year}`;
        for (const [button, atLimit] of [[previous, month === 0], [next, month === 11]] as const) {
          button.disabled = atLimit;
          button.style.opacity = atLimit ? '0.3' : '1';
          button.style.cursor = atLimit ? 'not-allowed' : 'pointer';
        }

        // Start the week on Monday and include adjacent dates to complete each row.
        const leading = (new Date(year, month, 1).getDay() + 6) % 7;
        const previousMonthEnd = new Date(year, month, 0).getDate();
        const monthEnd = new Date(year, month + 1, 0).getDate();
        const cellCount = Math.ceil((leading + monthEnd) / 7) * 7;
        const highlight = month === today.getMonth() ? today.getDate() : 0;
        let html = '';
        for (let cell = 0; cell < cellCount; cell++) {
          const day = cell - leading + 1;
          if (day < 1 || day > monthEnd) {
            const adjacentDay = day < 1 ? previousMonthEnd + day : day - monthEnd;
            html += `<div class="calendar-day other-month">${adjacentDay}</div>`;
          } else {
            const state = day === highlight ? ' today' : cell % 7 >= 5 ? ' weekend' : '';
            html += `<div class="calendar-day${state}">${day}</div>`;
          }
        }
        days.innerHTML = html;
      }

      function syncDay() {
        window.clearTimeout(midnightTimer);
        if (document.hidden || suspended) return;

        const now = new Date();
        if (now.toDateString() !== today.toDateString()) {
          // Follow today across months unless the reader is browsing another month of this year.
          const follow = now.getFullYear() !== today.getFullYear() || month === today.getMonth();
          today = now;
          if (follow) month = now.getMonth();
          if (follow || month === now.getMonth()) render();
        }
        const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
        midnightTimer = window.setTimeout(syncDay, midnight.getTime() - now.getTime());
      }

      function turn(delta: number, event: Event) {
        event.stopPropagation();
        const target = month + delta;
        if (target < 0 || target > 11) return;
        month = target;
        render();
      }

      previous.addEventListener('click', event => turn(-1, event), options);
      next.addEventListener('click', event => turn(1, event), options);
      document.addEventListener('visibilitychange', syncDay, options);
      window.addEventListener('pagehide', () => { suspended = true; syncDay(); }, options);
      window.addEventListener('pageshow', () => { suspended = false; syncDay(); }, options);
      render();
      syncDay();
      this.dispose = () => {
        lifetime.abort();
        window.clearTimeout(midnightTimer);
      };
    }

    disconnectedCallback() {
      this.dispose?.();
    }
  }

  if (!customElements.get('home-calendar')) customElements.define('home-calendar', HomeCalendar);
</script>
