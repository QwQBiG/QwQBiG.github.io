---
const portrait = '/generated/site/portrait-smile.webp';
---

<character-portrait class="portrait" data-expression="Smile">
  <div class="portrait-ambient" aria-hidden="true"></div>
  <img class="portrait-image is-visible" src={portrait} width="760" height="760"
    alt="QwQBiG's character" decoding="async" fetchpriority="high" draggable="false" />
  <img class="portrait-image" width="760" height="760" alt="" decoding="async" draggable="false" />
  <button type="button" class="portrait-expression-button" title="Click to change expression"
    aria-label="Current expression: Smile. Click to change expression" aria-busy="false">
    <span class="portrait-expression-hint" aria-hidden="true">Tap to change</span>
  </button>
  <span class="portrait-status sr-only" aria-live="polite" aria-atomic="true">Current expression: Smile</span>
</character-portrait>

<script>
  import { scheduleBackgroundTask } from '../utils/background-tasks';
  import { createPortraitCache, createPortraitSwitcher, decodePortrait } from '../utils/portrait';

  const expressions = ['Smile', 'Happy', 'Wink', 'Shy'];
  const portraitURL = (index: number) => `/generated/site/portrait-${expressions[index].toLowerCase()}.webp`;

  class CharacterPortrait extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      if (this.cleanup) return;
      this.dataset.ready = 'true';
      const button = this.querySelector<HTMLButtonElement>('button')!;
      const hint = this.querySelector<HTMLElement>('.portrait-expression-hint')!;
      const status = this.querySelector<HTMLElement>('.portrait-status')!;
      const images = [...this.querySelectorAll<HTMLImageElement>('.portrait-image')];
      const lifetime = new AbortController();
      const initial = Math.max(0, expressions.indexOf(this.dataset.expression ?? 'Smile'));
      let activeImage = Math.max(0, images.findIndex((image) => image.classList.contains('is-visible')));
      let visualIndex = initial;
      let fadeTimer: ReturnType<typeof setTimeout> | undefined;
      let finishFade: (() => void) | undefined;
      const backgroundImages = new Set<number>();
      const loadingImages = new Map<number, HTMLImageElement>();
      const cache = createPortraitCache<HTMLImageElement>((index, signal) => (
        new Promise((resolve, reject) => {
          const image = new Image();
          loadingImages.set(index, image);
          image.decoding = 'async';
          image.fetchPriority = 'low';
          const clear = () => {
            image.onload = null;
            image.onerror = null;
            signal.removeEventListener('abort', abort);
            if (loadingImages.get(index) === image) loadingImages.delete(index);
          };
          const abort = () => {
            clear();
            image.removeAttribute('src');
            reject(new Error('Portrait removed'));
          };
          image.onload = () => {
            void decodePortrait(image, signal).then(() => {
              clear();
              if (!signal.aborted) resolve(image);
            }, (error: unknown) => { clear(); reject(error); });
          };
          image.onerror = () => { clear(); reject(new Error('Portrait image unavailable')); };
          signal.addEventListener('abort', abort, { once: true });
          image.src = portraitURL(index);
        })
      ));

      const canWarmInBackground = () => {
        const connection = (navigator as Navigator & {
          connection?: { saveData?: boolean; effectiveType?: string };
        }).connection;
        return !connection?.saveData;
      };
      const loadForInteraction = (index: number) => {
        const pending = cache.load(index);
        const image = loadingImages.get(index);
        if (image) image.fetchPriority = 'high';
        return pending;
      };
      const warm = (index: number) => {
        if (lifetime.signal.aborted || backgroundImages.has(index) || !canWarmInBackground()) return;
        backgroundImages.add(index);
        let ready = false;
        const task = scheduleBackgroundTask({
          key: `portrait:${portraitURL(index)}`,
          priority: 'image',
          signal: lifetime.signal,
          // Keep an image already being decoded available to an expression click.
          run: async (signal) => {
            if (signal.aborted || !canWarmInBackground()) return;
            await cache.load(index);
            ready = !signal.aborted;
          },
        });
        void task.done.then(() => {
          if (!ready) backgroundImages.delete(index);
        });
      };
      const renderDisplayed = (index: number) => {
        this.dataset.expression = expressions[index];
        hint.textContent = `${expressions[index]} · Tap again`;
        button.title = 'Click to change expression';
        button.setAttribute('aria-label', `Current expression: ${expressions[index]}. Click to change expression`);
        status.textContent = `Current expression: ${expressions[index]}`;
      };
      const switcher = createPortraitSwitcher({
        count: expressions.length,
        initial,
        load: loadForInteraction,
        prepare: async (image) => {
          const nextImage = 1 - activeImage;
          images[nextImage].src = image.src;
          await decodePortrait(images[nextImage], lifetime.signal);
        },
        fade: (index) => {
          const nextImage = 1 - activeImage;
          images[nextImage].classList.add('is-visible');
          images[activeImage].classList.remove('is-visible');
          images[nextImage].alt = "QwQBiG's character";
          images[activeImage].alt = '';
          activeImage = nextImage;
          visualIndex = index;
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          return new Promise<void>((resolve) => {
            finishFade = resolve;
            fadeTimer = setTimeout(() => {
              fadeTimer = undefined;
              finishFade = undefined;
              resolve();
            }, reduceMotion ? 0 : 220);
          });
        },
        onChange: (state, reason) => {
          button.setAttribute('aria-busy', String(state.busy));
          if (reason === 'request') return;
          this.dataset.expression = expressions[state.displayed];
          if (state.failed) {
            hint.textContent = 'Tap to retry';
            button.title = 'Image unavailable. Click to retry';
            button.setAttribute('aria-label', `Current expression: ${expressions[state.displayed]}. Image unavailable. Click to retry`);
            status.textContent = 'Expression image unavailable. The current portrait is unchanged. Click to retry.';
            return;
          }
          renderDisplayed(state.displayed);
          if (canWarmInBackground()) warm((state.requested + 1) % expressions.length);
        },
      });

      const warmNext = () => {
        void loadForInteraction((switcher.state.requested + 1) % expressions.length).catch(() => {});
      };
      const listenerOptions = { signal: lifetime.signal };
      button.addEventListener('click', () => switcher.next(), listenerOptions);
      button.addEventListener('pointerenter', warmNext, { ...listenerOptions, passive: true });
      button.addEventListener('pointerdown', warmNext, { ...listenerOptions, passive: true });
      button.addEventListener('focus', warmNext, listenerOptions);

      // The shared queue waits for the page to load and gives navigation priority.
      const remaining = Array.from({ length: expressions.length - 1 }, (_, offset) => (
        (initial + offset + 1) % expressions.length
      ));
      const initialReady = () => {
        void decodePortrait(images[activeImage], lifetime.signal).catch(() => {})
          .then(() => lifetime.signal.aborted ? undefined : cache.load(initial).catch(() => {}))
          .then(() => remaining.forEach(warm));
      };
      if (images[activeImage].complete) initialReady();
      else images[activeImage].addEventListener('load', initialReady, { ...listenerOptions, once: true });

      this.cleanup = () => {
        switcher.dispose();
        lifetime.abort();
        cache.dispose();
        loadingImages.clear();
        backgroundImages.clear();
        if (fadeTimer !== undefined) clearTimeout(fadeTimer);
        finishFade?.();
        renderDisplayed(visualIndex);
        button.setAttribute('aria-busy', 'false');
        delete this.dataset.ready;
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get('character-portrait')) customElements.define('character-portrait', CharacterPortrait);
</script>

<style>
  .portrait { display: block; position: relative; width: 100%; height: 100%; }
  .portrait-ambient { position: absolute; inset: 0; border-radius: 50%; background: rgba(233, 213, 255, 0.12); }
  .portrait-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 220ms ease-in-out;
    pointer-events: none;
  }
  .portrait-image.is-visible { opacity: 1; }
  .portrait-expression-button {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 50%;
    padding: 0;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .portrait-expression-button:focus-visible { outline: 2px solid #a78bfa; outline-offset: -6px; }
  .portrait-expression-hint {
    position: absolute;
    bottom: 12%;
    left: 50%;
    transform: translateX(-50%);
    padding: 3px 9px;
    border: 1px solid rgba(196, 181, 253, 0.3);
    border-radius: 999px;
    color: #70548d;
    background: rgba(255, 255, 255, 0.74);
    font-size: clamp(10px, 1vw, 11px);
    line-height: 1.4;
    letter-spacing: 0.03em;
    white-space: nowrap;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) { .portrait-image { transition: none; } }
</style>
