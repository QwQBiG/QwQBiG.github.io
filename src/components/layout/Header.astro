---
interface NavItem {
  name: string;
  url: string;
}

const navItems: NavItem[] = [
  { name: '归档', url: '/archives/' },
  { name: '合集', url: '/series/' },
  { name: '标签', url: '/tags/' },
  { name: '关于', url: '/about/' },
  { name: '搜索', url: '/search/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-bg-primary/80 backdrop-blur-md border-b border-border-color transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img src="/generated/site/avatar-160.webp" alt="QwQBiG" class="w-10 h-10 rounded-full border-2 border-primary/30 group-hover:border-primary transition-colors" />
        <span class="font-sans font-bold text-xl text-primary hidden sm:block">QwQBiG's World</span>
      </a>
      
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.url}
            class:list={[
              'px-4 py-2 rounded-lg font-sans font-medium text-sm transition-all duration-200',
              currentPath === item.url || currentPath.startsWith(item.url.slice(0, -1))
                ? 'text-primary bg-primary/10'
                : 'text-text-secondary hover:text-primary hover:bg-primary/5'
            ]}
          >
            {item.name}
          </a>
        ))}
      </nav>
      
      <!-- Right Side -->
      <div class="flex items-center gap-2">
        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-toggle"
          class="md:hidden p-2 rounded-lg text-text-secondary hover:text-primary hover:bg-primary/10 transition-all duration-200"
          aria-label="打开菜单"
        >
          <svg class="w-6 h-6 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-border-color bg-bg-primary">
    <nav class="px-4 py-3 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.url}
          class:list={[
            'block px-4 py-3 rounded-lg font-sans font-medium transition-all duration-200',
            currentPath === item.url || currentPath.startsWith(item.url.slice(0, -1))
              ? 'text-primary bg-primary/10'
              : 'text-text-secondary hover:text-primary hover:bg-primary/5'
          ]}
        >
          {item.name}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  
  
  // Mobile Menu Toggle
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = mobileMenuToggle?.querySelector('.menu-icon');
  const closeIcon = mobileMenuToggle?.querySelector('.close-icon');
  
  mobileMenuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
