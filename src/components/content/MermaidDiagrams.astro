<script>
  let diagramLifetime: AbortController | undefined;
  let diagramBody: HTMLElement | undefined;
  let diagramPage = 0;

  type RenderDiagram = (block: HTMLElement) => Promise<void>;

  function observeDiagrams(blocks: NodeListOf<HTMLElement>, signal: AbortSignal) {
    if (!blocks.length) return;
    const margin = 600;
    const nearby = new Set<HTMLElement>();
    let observer: IntersectionObserver | undefined;
    let render: RenderDiagram | undefined;
    let running = false;
    let frame: number | undefined;

    const fragment = watchDiagramFragment(blocks[0].closest('article'), signal,
      () => running || frame !== undefined || nearby.size > 0,
      () => { if (frame === undefined) void runNext(); });

    function nearest() {
      if (!observer) return nearby.values().next().value;
      let next: HTMLElement | undefined;
      let shortest = Infinity;
      for (const block of nearby) {
        // Scroll and layout can change while an import or another diagram is pending.
        const rect = block.getBoundingClientRect();
        const distance = Math.max(0, rect.top - window.innerHeight, -rect.bottom);
        if (distance > margin) nearby.delete(block);
        else if (distance < shortest) {
          next = block;
          shortest = distance;
        }
      }
      return next;
    }

    async function runNext() {
      frame = undefined;
      if (signal.aborted || fragment?.travelling() || running || !nearby.size) return;
      running = true;
      try {
        render ??= await loadRenderer(signal);
        if (signal.aborted || fragment?.travelling() || !render) return;
        const block = nearest();
        if (!block) return;
        nearby.delete(block);
        observer?.unobserve(block);
        await render(block);
      } catch (error) {
        if (!signal.aborted) console.error('Mermaid 加载失败:', error);
        if (!render) nearby.clear();
      } finally {
        running = false;
        if (!signal.aborted && !fragment?.travelling() && nearby.size) frame = requestAnimationFrame(runNext);
      }
    }

    if (typeof IntersectionObserver === 'function') {
      observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          const block = entry.target as HTMLElement;
          if (entry.isIntersecting) nearby.add(block);
          else nearby.delete(block);
        }
        if (frame === undefined) void runNext();
      }, { rootMargin: `${margin}px 0px` });
      blocks.forEach(block => observer!.observe(block));
    } else {
      blocks.forEach(block => nearby.add(block));
      void runNext();
    }
    signal.addEventListener('abort', () => {
      observer?.disconnect();
      nearby.clear();
      if (frame !== undefined) cancelAnimationFrame(frame);
    }, { once: true });
  }

  // Let native fragment scrolling pass intervening diagrams before resolving any new layouts.
  function watchDiagramFragment(article: HTMLElement | null, signal: AbortSignal, busy: () => boolean, resume: () => void) {
    if (!article) return;
    let heading: HTMLElement | undefined;
    let travelling = false;
    let timer: number | undefined;
    const resize = typeof ResizeObserver === 'function' ? new ResizeObserver(align) : undefined;
    const options = { signal, passive: true };
    function clear() {
      window.clearTimeout(timer);
      resize?.disconnect();
      heading = undefined;
      travelling = false;
    }
    function cancel() {
      const paused = travelling;
      clear();
      if (paused && !signal.aborted) resume();
    }
    function align() {
      if (!heading || travelling) return;
      const margin = parseFloat(getComputedStyle(heading).scrollMarginTop) || 0;
      const offset = heading.getBoundingClientRect().top - margin;
      if (Math.abs(offset) > 2) heading.scrollIntoView({ behavior: 'instant', block: 'start' });
    }
    function finish() {
      travelling = false;
      align();
      resume();
      // A near diagram may still be downloading or applying its final SVG size.
      function releaseWhenIdle() {
        if (!busy()) clear();
        else timer = window.setTimeout(releaseWhenIdle, 250);
      }
      timer = window.setTimeout(releaseWhenIdle, 250);
    }
    function waitForScroll() {
      if (!travelling) return;
      window.clearTimeout(timer);
      timer = window.setTimeout(finish, 160);
    }
    function follow(hash: string) {
      let id: string;
      try { id = decodeURIComponent(hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target || !article!.contains(target) || !target.matches('h1, h2, h3, h4, h5, h6')) return;
      clear();
      heading = target;
      travelling = true;
      resize?.observe(article!);
      waitForScroll();
    }
    document.addEventListener('click', event => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      if (link?.hash && !link.target && !link.hasAttribute('download')) follow(link.hash);
    }, { signal, capture: true });
    window.addEventListener('scroll', waitForScroll, options);
    for (const name of ['wheel', 'touchstart', 'pointerdown', 'keydown']) window.addEventListener(name, cancel, options);
    signal.addEventListener('abort', clear, { once: true });
    if (location.hash && !history.state?.scrollY) follow(location.hash);
    return { travelling: () => travelling };
  }

  async function loadRenderer(signal: AbortSignal): Promise<RenderDiagram | undefined> {
    const { default: mermaid } = await import('mermaid');
    if (signal.aborted) return;
    const page = ++diagramPage;

    // 初始化 Mermaid - 禁用自动宽度限制，确保完整显示。
    mermaid.initialize({
      startOnLoad: false,
      theme: 'default',
      themeVariables: {
        background: 'transparent',
        primaryColor: '#fce4ec',
        primaryTextColor: '#333',
        primaryBorderColor: '#ec4899',
        lineColor: '#9c27b0',
        secondaryColor: '#f8bbd9',
        tertiaryColor: '#f3e5f5'
      },
      flowchart: {
        useMaxWidth: false,
        htmlLabels: true,
        curve: 'basis',
        padding: 20
      },
      sequence: {
        useMaxWidth: false,
        diagramMarginX: 50,
        diagramMarginY: 20
      }
    });

    let index = 0;
    return async block => {
      if (block.hasAttribute('data-mermaid-rendered')) return;
      const code = block.querySelector('code');
      if (!code) return;
      block.setAttribute('data-mermaid-rendered', 'true');

      const graphDefinition = code.textContent ?? '';
      const id = `mermaid-${page}-${++index}`;

      // 创建外层容器 - 模仿代码块样式
      const wrapper = document.createElement('div');
      wrapper.className = 'mermaid-wrapper';
      wrapper.style.cssText = 'position: relative; margin: 1.5em 0; border-radius: 16px; background: linear-gradient(135deg, #fff0f5 0%, #ffeef8 100%); box-shadow: 0 4px 20px rgba(232, 74, 122, 0.08), 0 8px 32px rgba(232, 74, 122, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.6); overflow: hidden; border: 1px solid rgba(232, 74, 122, 0.1);';

      // 创建头部 - 模仿代码块头部样式
      const header = document.createElement('div');
      header.className = 'code-header';
      header.lang = 'en';
      header.style.cssText = 'position: relative; height: 40px; background: linear-gradient(135deg, #ffe0ed 0%, #ffd6e8 100%); border-bottom: 1px solid rgba(232, 74, 122, 0.15); z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 0 12px;';

      // 左侧：Mermaid 标签
      const langContainer = document.createElement('div');
      langContainer.style.cssText = 'display: flex; align-items: center;';
      const langLabel = document.createElement('span');
      langLabel.textContent = 'Mermaid';
      langLabel.style.cssText = 'height: 40px; padding: 0 16px; font-family: var(--site-mono); font-size: 13px; font-weight: 600; color: #e84a7a; display: flex; align-items: center;';
      langContainer.appendChild(langLabel);

      // 右侧：按钮组 - 模仿代码块按钮样式
      const buttonsContainer = document.createElement('div');
      buttonsContainer.style.cssText = 'display: flex; align-items: center; gap: 8px;';

      // 创建按钮 - 使用与代码块相同的样式
      const createBtn = (className, title) => {
        const btn = document.createElement('button');
        btn.className = className;
        btn.title = title;
        btn.style.cssText = 'height: 24px; padding: 0 10px; font-family: var(--site-sans); font-size: 12px; font-weight: 600; color: #e84a7a; background: rgba(232, 74, 122, 0.1); border: 1px solid rgba(232, 74, 122, 0.3); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;';
        return btn;
      };

      const zoomOutBtn = createBtn('mermaid-zoom-out', 'Zoom out');
      zoomOutBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M19 13H5v-2h14v2z"/></svg>';

      const resetBtn = createBtn('mermaid-reset', 'Reset view');
      resetBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>';

      const zoomInBtn = createBtn('mermaid-zoom-in', 'Zoom in');
      zoomInBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>';

      const fullscreenBtn = createBtn('mermaid-fullscreen', 'Enter full screen');
      fullscreenBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>';

      buttonsContainer.appendChild(zoomOutBtn);
      buttonsContainer.appendChild(resetBtn);
      buttonsContainer.appendChild(zoomInBtn);
      buttonsContainer.appendChild(fullscreenBtn);

      header.appendChild(langContainer);
      header.appendChild(buttonsContainer);

      // 创建图表内容区域 - 使用 auto height 确保完整显示
      const contentWrapper = document.createElement('div');
      contentWrapper.className = 'mermaid-content-wrapper';
      contentWrapper.style.cssText = 'padding: 16px 20px; overflow-x: auto; overflow-y: visible;';

      // 创建图表容器（支持拖动和缩放）
      const container = document.createElement('div');
      container.className = 'mermaid-container';
      container.style.cssText = 'position: relative; width: 100%; overflow: visible; cursor: grab; background: transparent; min-height: 100px;';

      // 创建内容层
      const content = document.createElement('div');
      content.className = 'mermaid-content';
      content.style.cssText = 'position: relative; transform: scale(1); transform-origin: top left; transition: transform 0.2s ease; display: inline-block; min-width: 100%;';

      contentWrapper.appendChild(container);
      container.appendChild(content);

      wrapper.appendChild(header);
      wrapper.appendChild(contentWrapper);

      try {
        const { svg } = await mermaid.render(id, graphDefinition);
        if (signal.aborted || !block.isConnected) return;
        content.innerHTML = svg;
        block.before(wrapper);
        block.style.display = 'none';

        // 确保SVG完整显示
        const svgElement = content.querySelector('svg');
        if (svgElement) {
          // 移除固定宽高，让SVG自适应内容
          svgElement.style.maxWidth = 'none';
          svgElement.style.width = 'auto';
          svgElement.style.height = 'auto';
          svgElement.style.display = 'block';
          svgElement.style.overflow = 'visible';

          // 修复foreignObject问题，确保多行文本显示完整
          const foreignObjects = svgElement.querySelectorAll('foreignObject');
          foreignObjects.forEach(fo => {
            fo.style.overflow = 'visible';
            const div = fo.querySelector('div');
            if (div) {
              div.style.whiteSpace = 'pre-wrap';
              div.style.wordBreak = 'break-word';
            }
          });

          // 确保SVG的g元素也不会截断内容
          const gElements = svgElement.querySelectorAll('g');
          gElements.forEach(g => {
            g.style.overflow = 'visible';
          });

        }

        // 初始化交互功能
        initMermaidInteraction(wrapper, container, content, zoomOutBtn, zoomInBtn, resetBtn, fullscreenBtn, signal);
      } catch (err) {
        if (signal.aborted || !block.isConnected) return;
        console.error('Mermaid 渲染失败:', err);
        content.innerHTML = '<div lang="en" style="color: red; padding: 20px;">This diagram could not be displayed.</div>';
        if (!wrapper.isConnected) block.before(wrapper);
      }
    };
  }

  // 初始化图表交互功能
  function initMermaidInteraction(wrapper, container, content, zoomOutBtn, zoomInBtn, resetBtn, fullscreenBtn, signal) {
    let scale = 1;
    let isDragging = false;
    let startX, startY, offsetX = 0, offsetY = 0;
    let isFullscreen = false;

    // 更新变换
    function updateTransform() {
      content.style.transform = `scale(${scale}) translate(${offsetX}px, ${offsetY}px)`;
    }

    // 初始适配与按钮、滚轮共用缩放状态。
    const svgElement = content.querySelector('svg');
    if (svgElement) {
      requestAnimationFrame(() => {
        if (signal.aborted || !svgElement.isConnected) return;
        const bbox = svgElement.getBBox();
        const clientRect = svgElement.getBoundingClientRect();

        if (bbox && bbox.width > 0 && bbox.height > 0) {
          container.style.minWidth = Math.ceil(bbox.width + bbox.x + 40) + 'px';
          container.style.minHeight = Math.ceil(bbox.height + bbox.y + 40) + 'px';

          const containerWidth = container.clientWidth || clientRect.width;
          const containerHeight = container.clientHeight || clientRect.height;

          if (containerWidth > 0 && containerHeight > 0) {
            const scaleX = containerWidth / (bbox.width + bbox.x);
            const scaleY = containerHeight / (bbox.height + bbox.y);
            const fitScale = Math.min(scaleX, scaleY, 1); // 不放大，只缩小

            if (fitScale < 1) {
              scale = fitScale;
              updateTransform();
            }
          }
        }
      });
    }

    // 按钮 hover 效果
    const buttons = [zoomOutBtn, zoomInBtn, resetBtn, fullscreenBtn];
    buttons.forEach(btn => {
      btn.addEventListener('mouseenter', () => {
        btn.style.background = 'rgba(232, 74, 122, 0.2)';
        btn.style.borderColor = 'rgba(232, 74, 122, 0.5)';
      });
      btn.addEventListener('mouseleave', () => {
        btn.style.background = 'rgba(232, 74, 122, 0.1)';
        btn.style.borderColor = 'rgba(232, 74, 122, 0.3)';
      });
    });

    // 放大
    zoomInBtn.addEventListener('click', () => {
      scale = Math.min(scale * 1.2, 5);
      updateTransform();
    });

    // 缩小
    zoomOutBtn.addEventListener('click', () => {
      scale = Math.max(scale / 1.2, 0.3);
      updateTransform();
    });

    // 重置
    resetBtn.addEventListener('click', () => {
      scale = 1;
      offsetX = 0;
      offsetY = 0;
      updateTransform();
    });

    // 全屏
    fullscreenBtn.addEventListener('click', () => {
      if (!isFullscreen) {
        if (wrapper.requestFullscreen) {
          wrapper.requestFullscreen();
        } else if (wrapper.webkitRequestFullscreen) {
          wrapper.webkitRequestFullscreen();
        }
        isFullscreen = true;
        wrapper.classList.add('mermaid-fullscreen');
        fullscreenBtn.title = 'Exit full screen';
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        } else if (document.webkitExitFullscreen) {
          document.webkitExitFullscreen();
        }
        isFullscreen = false;
        wrapper.classList.remove('mermaid-fullscreen');
        fullscreenBtn.title = 'Enter full screen';
      }
    });

    // 监听全屏变化
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        isFullscreen = false;
        wrapper.classList.remove('mermaid-fullscreen');
        fullscreenBtn.title = 'Enter full screen';
      }
    }, { signal });

    // 鼠标拖动
    container.addEventListener('mousedown', (e) => {
      if (e.target.tagName === 'BUTTON') return;
      isDragging = true;
      startX = e.clientX - offsetX;
      startY = e.clientY - offsetY;
      container.style.cursor = 'grabbing';
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      offsetX = e.clientX - startX;
      offsetY = e.clientY - startY;
      updateTransform();
    }, { signal });

    document.addEventListener('mouseup', () => {
      isDragging = false;
      container.style.cursor = 'grab';
    }, { signal });

    // 鼠标滚轮缩放
    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? 0.9 : 1.1;
      scale = Math.max(0.3, Math.min(5, scale * delta));
      updateTransform();
    });
  }

  const renderDiagrams = () => {
    if (diagramBody === document.body) return;
    diagramLifetime?.abort();
    diagramBody = document.body;
    diagramLifetime = new AbortController();
    const blocks = document.querySelectorAll<HTMLElement>('pre.language-mermaid, pre[class*="mermaid"]');
    observeDiagrams(blocks, diagramLifetime.signal);
  };

  // 页面加载完成后渲染。
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderDiagrams, { once: true });
  } else {
    renderDiagrams();
  }
  document.addEventListener('astro:page-load', renderDiagrams);
  document.addEventListener('astro:before-swap', () => {
    diagramLifetime?.abort();
    diagramBody = undefined;
  });
</script>
