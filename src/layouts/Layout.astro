---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import CodeBlockScripts from '../components/content/CodeBlockScripts.astro';
import MermaidDiagrams from '../components/content/MermaidDiagrams.astro';
import mermaidStyles from '../styles/mermaid-diagrams.css?inline';
import codeStyles from '../styles/code-blocks.css?url';
import katexStyles from 'katex/dist/katex.min.css?url';
import { getPageFeatures } from '../utils/page-features';
import ContentNavigation from '../components/content/ContentNavigation.astro';
import { isContentNavigationPath } from '../utils/content-navigation';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  canonicalURL?: string;
  gradientBg?: boolean;
}

const {
  title,
  description = "Computer science notes by QwQBiG.",
  image = '/ZhenXun.png',
  type = 'website',
  noIndex = false,
  canonicalURL = Astro.url.pathname,
  gradientBg = true
} = Astro.props;

const siteURL = new URL(canonicalURL, Astro.site || 'https://iqwqi.win');
const ogImage = new URL(image, Astro.site || 'https://iqwqi.win');
// Render once so resource loading follows actual content, including nested components.
const content = await Astro.slots.render('default');
const { hasCode, hasMath, hasMermaid } = getPageFeatures(content);
const useContentNavigation = isContentNavigationPath(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang="en" data-theme="light" class="reading-fonts scroll-smooth" style="color-scheme: only light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.setAttribute('data-theme', 'light');
        root.classList.remove('dark');
        root.style.colorScheme = 'only light';
        try {
          localStorage.setItem('theme', 'light');
        } catch {
          // 浅色模式不依赖本地存储权限。
        }
      })();
    </script>
    <!-- 缓存策略：HTML使用短缓存配合ETag，静态资源由服务器配置长期缓存 -->
    <meta http-equiv="Cache-Control" content="public, max-age=600" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteURL} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={siteURL} />
    <meta property="og:image" content={ogImage} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- No index for drafts -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/generated/site/avatar-160.webp" />
    
    <slot name="head" />

    <!-- Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    {useContentNavigation && <ContentNavigation />}
    {hasCode && <link rel="stylesheet" href={codeStyles} />}
    {hasMermaid && <style is:inline set:html={mermaidStyles} />}
    {hasMath && <link rel="stylesheet" href={katexStyles} />}
</head>
<body data-page-code={String(hasCode)} class={`site-page-shell min-h-[100dvh] min-h-screen flex flex-col transition-colors duration-300 ${gradientBg ? 'gradient-bg' : 'bg-bg-primary text-text-primary'}`}>
    <Fragment set:html={content} />

    {hasCode && <CodeBlockScripts />}
    <!-- VanillaTilt 3D 倾斜效果 -->
    <script src="/js/vanilla-tilt.js" defer></script>
    
    {hasMermaid && <MermaidDiagrams />}

    <style is:global>
      /* Markdown表格样式 - 粉紫主题 */
      .prose table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5em 0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(232, 74, 122, 0.08), 0 8px 32px rgba(232, 74, 122, 0.05);
        border: 1px solid rgba(232, 74, 122, 0.15);
      }

      .prose table thead {
        background: linear-gradient(135deg, #ffe0ed 0%, #ffd6e8 100%);
      }

      .prose table thead th {
        padding: 12px 16px;
        font-weight: 600;
        color: #e84a7a;
        border-bottom: 2px solid rgba(232, 74, 122, 0.2);
        border-right: 2px solid rgba(232, 74, 122, 0.15);
        font-family: var(--site-mono);
        font-size: 14px;
      }

      .prose table thead th:last-child {
        border-right: none;
      }

      .prose table tbody tr {
        background: linear-gradient(135deg, #fff0f5 0%, #ffeef8 100%);
        transition: background 0.2s ease;
      }

      .prose table tbody tr:nth-child(even) {
        background: linear-gradient(135deg, #fff5f7 0%, #fff0f5 100%);
      }

      .prose table tbody tr:hover {
        background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 100%);
      }

      .prose table tbody td {
        padding: 12px 16px;
        border-bottom: 1px solid rgba(232, 74, 122, 0.1);
        border-right: 2px solid rgba(232, 74, 122, 0.15);
        color: #333;
        font-size: 14px;
      }

      .prose table tbody td:last-child {
        border-right: none;
      }

      .prose table tbody tr:last-child td {
        border-bottom: none;
      }

      /* 表格头部代码块样式 */
      .prose table code {
        background: rgba(232, 74, 122, 0.1);
        color: #e84a7a;
        padding: 2px 6px;
        border-radius: 4px;
        font-family: var(--site-mono);
        font-size: 12px;
      }

      /* IP数据报格式图样式 */
      .ip-header-diagram {
        margin: 1.5em 0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(232, 74, 122, 0.08), 0 8px 32px rgba(232, 74, 122, 0.05);
        border: 2px solid rgba(232, 74, 122, 0.2);
        background: #fff;
      }

      .ip-header-title {
        background: linear-gradient(135deg, #ffe0ed 0%, #ffd6e8 100%);
        padding: 12px 16px;
        font-weight: 600;
        color: #e84a7a;
        text-align: center;
        font-family: var(--site-mono);
        font-size: 14px;
        border-bottom: 2px solid rgba(232, 74, 122, 0.2);
      }

      .bit-labels {
        display: flex;
        justify-content: space-between;
        padding: 8px 16px;
        background: linear-gradient(135deg, #fff5f7 0%, #fff0f5 100%);
        border-bottom: 1px solid rgba(232, 74, 122, 0.1);
        font-family: var(--site-mono);
        font-size: 12px;
        color: #e84a7a;
      }

      .ip-row {
        display: flex;
        border-bottom: 1px solid rgba(232, 74, 122, 0.15);
      }

      .ip-row:last-child {
        border-bottom: none;
      }

      .ip-cell {
        padding: 12px 8px;
        text-align: center;
        font-size: 13px;
        color: #333;
        border-right: 2px solid rgba(232, 74, 122, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
      }

      .ip-cell:last-child {
        border-right: none;
      }

      .ip-cell.full {
        width: 100%;
      }

      /* 交替行颜色 */
      .ip-row:nth-child(odd) .ip-cell {
        background: linear-gradient(135deg, #fff0f5 0%, #ffeef8 100%);
      }

      .ip-row:nth-child(even) .ip-cell {
        background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 100%);
      }

      /* 可选字段 - 虚线边框 */
      .ip-row.optional .ip-cell {
        background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
        border-style: dashed;
        border-width: 2px;
        border-color: rgba(156, 39, 176, 0.3);
      }

      /* 数据部分 */
      .ip-row.data .ip-cell {
        background: linear-gradient(135deg, #fff5f7 0%, #fce4ec 100%);
        font-weight: 500;
      }

      /* TCP标志位样式 */
      .ip-cell.tcp-flags {
        padding: 4px 2px;
      }

      .ip-cell.tcp-flags .flag-row {
        display: flex;
        justify-content: space-around;
        width: 100%;
        height: 100%;
      }

      .ip-cell.tcp-flags .flag-row span {
        font-family: var(--site-mono);
        font-size: 11px;
        font-weight: 600;
        color: #e84a7a;
        line-height: 1.2;
        text-align: center;
      }
    </style>
</body>
</html>
