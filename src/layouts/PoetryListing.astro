---
import { readingListPrefetch } from '../utils/content-navigation';
import Layout from './Layout.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingNavCard from '../components/layout/FloatingNavCard.astro';
import ContentIcon from '../components/ui/ContentIcon.astro';
import { formatDisplayDate } from '../utils/date';
import { getPoetryListing } from '../utils/content';
import { loadContent } from '../utils/load-content';

interface Props { genre?: string }
const { genre: selectedGenre } = Astro.props;
const { poetryPosts } = await loadContent();
const sortedPosts = selectedGenre ? poetryPosts.filter(post => post.data.genre === selectedGenre) : poetryPosts;

// Get unique genres and moods for filtering
const allGenres = [...new Set(poetryPosts.map(p => p.data.genre))];
const allMoods = [...new Set(sortedPosts.flatMap(p => p.data.mood))];

const pageTitle = selectedGenre ? `${selectedGenre} · Poetry - QwQBiG's World` : "Poetry - QwQBiG's World";
const pageDescription = "A collection of original poems.";
---

<Layout title={pageTitle} description={pageDescription}>
  <FloatingNavCard />

  <main class="flex-1 py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="text-center mb-12">
        <h1 class="font-sans font-bold text-3xl md:text-4xl text-text-primary mb-4 inline-flex items-center gap-3">
          <ContentIcon name="poetry" />Poetry
        </h1>
        <p class="font-sans text-lg text-text-secondary">
          {sortedPosts.length} {sortedPosts.length === 1 ? 'poem' : 'poems'}
        </p>
      </div>

      <!-- Filters -->
      {(allGenres.length > 0 || allMoods.length > 0) && (
        <div class="mb-8 flex flex-wrap gap-4 justify-center">
          {allGenres.length > 0 && (
            <div class="flex flex-wrap gap-2 items-center">
              <span class="text-sm text-text-secondary">Genres</span>
              {selectedGenre && <a href="/poetry/" class="px-3 py-1 text-sm bg-primary/10 text-primary rounded-full">All poems</a>}
              {allGenres.map(genre => (
                <a
                  href={`/poetry/genres/${encodeURIComponent(genre)}/`}
                  aria-current={genre === selectedGenre ? 'page' : undefined}
                  class:list={['px-3 py-1 text-sm bg-primary/10 text-primary rounded-full', { 'font-semibold underline': genre === selectedGenre }]}
                >
                  {genre}
                </a>
              ))}
            </div>
          )}
          {allMoods.length > 0 && (
            <div class="flex flex-wrap gap-2 items-center">
              <span class="text-sm text-text-secondary">Themes</span>
              {allMoods.map(mood => (
                <span class="px-3 py-1 text-sm bg-secondary/10 text-secondary rounded-full">
                  {mood}
                </span>
              ))}
            </div>
          )}
        </div>
      )}

      <!-- Poetry Grid -->
      {sortedPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {getPoetryListing(sortedPosts).map((post, index) => (
            <a
              data-astro-prefetch={readingListPrefetch(index)}
              href={`/poetry/${post.slug}/`}
              class="group block p-6 bg-white/30 backdrop-blur-sm rounded-2xl border border-white/50 hover:bg-white/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
            >
              <div class="flex items-start justify-between gap-2 mb-3">
                <div class="flex min-w-0 items-center gap-2">
                  <h2 class="font-sans font-bold text-xl text-text-primary group-hover:text-primary transition-colors line-clamp-2">
                    {post.data.title}
                  </h2>
                  {post.data.pin && (
                    <span class="inline-flex shrink-0 items-center gap-1 text-xs font-medium text-primary">
                      <ContentIcon name="pin" class="h-3 w-3" />Pinned
                    </span>
                  )}
                </div>
                {post.data.genre && (
                  <span class="shrink-0 px-2 py-0.5 text-xs bg-primary/10 text-primary rounded-full">
                    {post.data.genre}
                  </span>
                )}
              </div>

              {post.data.description && (
                <p class="text-text-secondary text-sm mb-4 line-clamp-2">
                  {post.data.description}
                </p>
              )}

              <div class="flex items-center justify-between text-xs text-text-muted">
                <time datetime={post.data.date.toISOString()}>
                  {formatDisplayDate(post.data.date)}
                </time>

                {post.data.mood && post.data.mood.length > 0 && (
                  <div class="flex gap-1">
                    {post.data.mood.slice(0, 2).map(m => (
                      <span class="px-1.5 py-0.5 bg-secondary/10 text-secondary rounded">
                        {m}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-text-secondary">No poems yet.</p>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
